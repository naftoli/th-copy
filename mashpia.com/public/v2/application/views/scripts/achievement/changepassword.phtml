	<div class="col_content camper">
		<div id="lists" class="module lists forms">			
			<div class="module_content">
				<ul>
					<li>
						Please provide your current password and choose your new password.</li>
				</ul>
			</div>
		</div>
		<div class="module form" id="module-info">
			<div class="module_content list">
				<form name="registration_administrator" id="registration_administrator" method="post" action="">
					<input type="hidden" id="registration_administrator_data" value="" />
					<ul>
						<li>
							<span class="label">Current Password:</span>
							<span class="input"><input autocomplete="off" type="password" class="required" id="current_password" name="current_password" value="" size="25" minlength="2" /></span>
							<div class="clear"></div>
						</li>
						<div class="processing_status"></div>
						<li>Insert your new password of 6 characters or more.</li>
						<li>
							<span class="label">New Password:</span>
							<span class="input"><input autocomplete="off" type="text" class="required" id="new_password" name="new_password" value="" size="25" minlength="2" /></span>
							<div class="clear"></div>
						</li>
						<div class="processing_status"></div>
						<li>
							<span class="label">Confirm New Password:</span>
							<span class="input"><input autocomplete="off" type="text" class="required" id="confirm_new_password" name="confirm_new_password" value="" size="25" minlength="2" /></span>
							<div class="clear"></div>
						</li>
						<div class="processing_status"></div>
						<div id="processing_status" style="padding:4px"></div>
