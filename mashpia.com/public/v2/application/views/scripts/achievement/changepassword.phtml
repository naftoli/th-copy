<style>
	.processing_status {
		display: none;
		padding: 4px 0 8px 8px;
		color: red;
		width: 500px;
	}
</style>
<script language="javascript">
$(document).ready(function()
{
	$('.slider:last form a.submit').click( function(e) {
		$(".slider:last .processing_status").fadeOut();
		$.ajax({
			type : "POST",
			cache : false,
			start: $(".slider:last #processing_status").html('Loading...').fadeIn(),
			url : '<?php echo $sn . "/administration/changepassword" . $strParamPath; ?>',
			dataType : "text",
			data: $('.slider:last form').serialize(),
			success : function(strResponse) {
				//alert(strResponse);
				try {
					var arrResponse = jQuery.parseJSON(strResponse);
				} catch(e) {
					$(".slider:last #processing_status").html('Sorry, there was an error: VA-CP101-3RR3RE');
					alert("Sorry, there was an error: VA-CP101-3RR3RE");
					alert(strResponse);
					return;
				}
				if (typeof(arrResponse) != "object") {
					$(".slider:last #processing_status").html('Sorry, there was an error: VA-CP102-SDF8BX');
					alert("Sorry, there was an error: VA-CP102-SDF8BX");
					return;
				} else {
					$(".slider:last #processing_status").fadeOut();
					if (arrResponse["error"]) {
						if (typeof(arrResponse["error"]) != "object") {
							$(".slider:last #processing_status").html(arrResponse["error"]);
						} else {
							for (strField in arrResponse["error"])
							{
								$(".slider:last #" + strField).closest("li").next().html(arrResponse["error"][strField]).fadeIn();
							}
						}
					} else if (arrResponse["success"] == "true") {
						$(".slider:last #processing_status").html("Success").fadeIn();
					} else {
						alert("Sorry, there was an error: VA-CP103-DS7DDS");
						//alert($.dump(arrResponse));
					}
				}
			}
		});
	});
});
</script>
