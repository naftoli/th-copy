					$('.students .bar.associate_students').data('values', {});
					$('.bar.associate_campaigns').html('Associate a campaign or task');
					$('.bar.associate_campaigns').removeAttr('task_id');
					$('.bar.associate_campaigns').removeAttr('campaign_id');
					$('.bar.associate_campaigns').removeAttr('objTask');
					$('.bar.associate_campaigns').removeAttr('objCampaign');
					$('.associate_campaigns_clear').addClass('hidden');

				} else {
					KioskAnnouncementsApp.fnLoadList(strItem);
				}
			});
			$('.one_column .select .left_menu:first').trigger('click');
			CKEDITOR.config.height = 220;
			CKEDITOR.config.removePlugins = 'elementspath';
			posteditor = CKEDITOR.appendTo($('.wysiwyg .pane')[0], null, "");
			CKEDITOR.config.readOnly = false;
			window.setTimeout(function () {
				$('.cke_button__about').remove();
			},1000);
		},
		'fnLoadTemplates' : function ()
		{
			var self = KioskAnnouncementsApp;
			$('.template').each(function () {
				var strTemplate = $(this).attr('template');
				var objClone = $(this).clone(true);
				objClone.removeClass('template');
				self.arrMemory.arrTemplates[strTemplate] = objClone;
				$(this).remove();
			});
		},
		'fnLoadList' : function (strItem)
		{
			var self = KioskAnnouncementsApp;
			$('.winner_display').addClass('hidden');
			$('#list_pane .nothing_to_show').addClass('hidden');
			$('.winner_display.messages_list').removeClass('hidden');
			$('#list_pane > .row:not(.header):not(.header2)').remove();
			$('.winner_display.messages_list .loading').removeClass('hidden');
			var arrParams = {
				'strItem' : strItem
			};
			$.ajax({
				type : "POST",
				cache : false,
				url : '<?php print $sn . "/hebrewschools/announcements/ajax/true" . $strParamPath; ?>',
				dataType : "text",
				data: arrParams,
				success : function(strResponse) {
					$('.winner_display.messages_list .loading').addClass('hidden');
					try {
						var arrResponse = jQuery.parseJSON(strResponse);
					} catch(e) {
						$.alert(strResponse);
						return;
					}
					if (typeof(arrResponse) != "object") {
						$.alert(strResponse);
						return;
					} else {
						self.fnDrawList(arrResponse, strItem);
					}
				}
			});
		},
		'fnDrawList' : function (arrList, strItem)
		{
			var self = KioskAnnouncementsApp;
			$('#list_pane .header').addClass('hidden');
			$('#list_pane .header2').addClass('hidden');
			if (strItem == 'submissions')
				$('#list_pane .header2').removeClass('hidden');
			else
				$('#list_pane .header').removeClass('hidden');
			if (!arrList.length)
				$('#list_pane .nothing_to_show').removeClass('hidden');
			for (var intItr in arrList)
			{
				var objAnnouncement = arrList[intItr];
				var objListItem;
				if (strItem == 'submissions')
					objListItem = $(self.arrMemory.arrTemplates['list_item2']).clone(true);
				else
					objListItem = $(self.arrMemory.arrTemplates['list_item']).clone(true);
				objListItem.data('objAnnouncement', objAnnouncement);
				objListItem.find('.created_by').html(objAnnouncement.objCreated.first_name + ' ' + objAnnouncement.objCreated.last_name);
				objListItem.find('.date_created').html(objAnnouncement.strSmallDate);
				objListItem.find('.title_message').html(objAnnouncement.headline);
				if (strItem == 'submissions')
					objListItem.find('.status').html(objAnnouncement.status);
				$('#list_pane').append(objListItem);
			}
			if (strItem == 'posts' || strItem == 'trash') {
				// load saved draft
				$('#list_pane .row').click(function () {
					$('.winner_display').addClass('hidden');
					$('.winner_display.create_new').removeClass('hidden');
					$('.create_new input.headline').focus();
					var objAnnouncement = $(this).data('objAnnouncement');
					$('.create_new input.headline').val(objAnnouncement.headline);
					var strContent = objAnnouncement.content;
					strContent = strContent.replace(/\|NEW_LINE\|/g, "\n");
					posteditor.setData(strContent);
					$('.one_column .select.selected').removeClass('selected');
					$('.one_column .select.edit')
					.removeClass('hidden')
					.addClass('selected')
					.find('.left_menu')
					.html(objAnnouncement.headline);
					$('.students .bar.associate_students').data('values', objAnnouncement.arrAnnouncementsStudents);
					$('.bar.associate_campaigns').html('Associate a campaign or task');
					$('.bar.associate_campaigns').removeAttr('task_id');
					$('.bar.associate_campaigns').removeAttr('campaign_id');
					$('.bar.associate_campaigns').removeData('objTask');
					$('.bar.associate_campaigns').removeData('objCampaign');
					if (objAnnouncement.task_id) {
						$('.bar.associate_campaigns').attr('task_id', objAnnouncement.task_id);
						$('.bar.associate_campaigns').data('objTask', objAnnouncement.objTask);
						$('.associate_campaigns_clear').removeClass('hidden');
					}
					if (objAnnouncement.campaign_id) {
						$('.bar.associate_campaigns').attr('campaign_id', objAnnouncement.campaign_id);
						$('.bar.associate_campaigns').data('objCampaign', objAnnouncement.objCampaign);
						$('.associate_campaigns_clear').removeClass('hidden');
					}
					$('.students .bar.associate_students .message_box span').html(Object.keys(objAnnouncement.arrAnnouncementsStudents).length);
					$('.create_new').attr('announcement_id', objAnnouncement.announcement_id);
					if (!!(objAnnouncement.task_id*1))
						$("#campaign_list_pop .student_row.task_id_" + objAnnouncement.task_id).trigger('click');
					else if (!!(objAnnouncement.campaign_id*1))
						$("#campaign_list_pop .student_row.campaign_id_" + objAnnouncement.campaign_id).trigger('click');
				});
			} else {
				$('#list_pane .row').click(function () {
					var objAnnouncement = $(this).data('objAnnouncement');
					var arrParams = {};
					if (objAnnouncement.status == 'Publish Request')
						arrParams.bottom_options2 = true;
					self.fnLoadMesssage(objAnnouncement, arrParams);
				});
			}
		},
		"fnLoadMesssage" : function (objAnnouncement, arrParams)
		{
			if (!arrParams)
				arrParams = {};
			if (!arrParams.bottom_options)
				$('#message_display .bottom_options').addClass('hidden');
			else
				$('#message_display .bottom_options').removeClass('hidden');
			if (!arrParams.bottom_options2)
				$('#message_display .bottom_options2').addClass('hidden');
			else
				$('#message_display .bottom_options2').removeClass('hidden');
			$('#message_display .publish_location').html(objAnnouncement.class_id ? 'Class' : 'School');
			$('body').addClass('noscroll');
			$('#backdrop').fadeTo('normal', 0.7);
			$("#message_display .overlay").fadeIn();
			$("#message_display .overlay").css({
				height: $(window).height()-60,
				width: 900
			});
			// $('#message_display').data('objAnnouncement');
			$('#message_display').css({
				"top" : Math.max(0, ($('body,html').scrollTop() + 20)) + 'px',
				"display" : "block"
			})
			.data('objAnnouncement', objAnnouncement);
			$('#message_display .message_title_text').html(objAnnouncement.headline);
			var strContent = '';

			strContent += '<div class="message_header">';
			strContent += '	<div class="message_created_by">By: <span>' + objAnnouncement.objCreatedBy.first_name + ' ' + objAnnouncement.objCreatedBy.last_name + '</span></div>';
			strContent += '	<div class="message_date">' + objAnnouncement.created + '</div>';
			strContent += '</div>';

			if (objAnnouncement.objCampaign)
			{
				strContent += '<div class="message_header">';
				strContent += '	<div class="message_campaign"><img src="<?php print $sn; ?>/imgs/v/src/' + objAnnouncement.objCampaign.image_id + '/w/25/h/25" /> <span>' + objAnnouncement.objCampaign.campaign_name + '</span>';
				if (objAnnouncement.objTask)
				{
					strContent += ': ' + objAnnouncement.objTask.task_name;
				}
				strContent += '</div></div>';
			}

			if (Object.keys(objAnnouncement.arrAnnouncementsStudents).length)
			{
				strContent += '<div class="associated_users">';
				for (var intUser in objAnnouncement.arrAnnouncementsStudents)
				{
					var objUser = objAnnouncement.arrAnnouncementsStudents[intUser];
					var strImage = objUser.image_id;
					if (!strImage)
						strImage = '0.gif';
					strContent += '	<div class="user_box" image_id="' + strImage + '"><div class="user_image"><img src="<?php print $sn; ?>/imgs/v/src/' + strImage + '/w/25/h/25" /></div><div class="user_name">' + objUser.first_name + ' ' + objUser.last_name + '</div></div>';
				}
				strContent += '</div>';
			}
			strContent += objAnnouncement.content.replace(/\|NEW_LINE\|/g, "\n");
			$('#message_display .message_content').html(strContent);
			$('#message_display .message_content').css({
				'max-height' : 1
			});
			$('#message_display .message_content').css({
				height : $('#message_display .message_content_parent').height() - 30,
				'max-height' : $('#message_display .message_content_parent').height() - 30
			});
			var fnUserItemOver = function () {
				var parent = $(this);
				var strImage = parent.attr('image_id');
				window.clearTimeout(refUserBoxTimeout);
				refUserBoxTimeout = window.setTimeout(function () {
					// open box
					var objPos = parent.position();
					objFloatingUserImage
					.removeClass('hidden')
					.css({
						left : objPos.left,
						top : objPos.top + 40
					});
					objFloatingUserImage.find('img').attr('src', '<?php print $sn; ?>/imgs/v/src/' + strImage + '/w/25/h/25');
					objFloatingUserImage.find('img').attr('src', '<?php print $sn; ?>/imgs/v/src/' + strImage + '/w/200/h/200');
				}, 100);
			};
			var fnUserItemOut = function () {
				window.clearTimeout(refUserBoxTimeout);
				refUserBoxTimeout = window.setTimeout(function () {
					// close box
					objFloatingUserImage
					.addClass('hidden');
				}, 200);
			};

			$('#message_display .user_box').mouseover(fnUserItemOver);
			$('#message_display .user_box').mouseout(fnUserItemOut);
			$('#user_floating_box').mouseover(function () {
				window.clearTimeout(refUserBoxTimeout);
			});
			$('#user_floating_box').mouseout(fnUserItemOut);

		},
		'load_students_list' : function (arrParams) {
			if (!arrParams)
				arrParams = {};
			arrParams.strItem = 'student_list';
			$.ajax({
				type : "POST",
				cache : false,
				url : '<?php print $sn . "/hebrewschools/announcements/ajax/true" . $strParamPath; ?>',
				dataType : "text",
				data: arrParams,
				success : function(strResponse) {
					try {
						var arrResponse = jQuery.parseJSON(strResponse);
					} catch(e) {
						$.alert(strResponse);
						return;
					}
					if (typeof(arrResponse) != "object") {
						$.alert(strResponse);
						return;
					} else {
						$('#student_list_pop .student_row').remove();
						$('#student_list_pop .students_list').scrollTop(0);
						$('#student_list_pop .students_list_header').append('<div class="student_row header">'
							+ '<div class="student_column" style="width:25px"></div>'
							+ '<div class="student_column" style="width:200px"><?php print text('[|Class|]'); ?></div>'
							+ '<div class="student_column" style="width:360px"><?php print text('[|Student|] Name'); ?></div>'
							+ '</div>');
						var arrValues = $('.students .bar.associate_students').data('values');
						for (var intItr in arrResponse.arrUsers)
						{
							var objUser = arrResponse.arrUsers[intItr];
							var domUser = $('<div class="student_row' + (arrValues[objUser.user_id] ? ' down' : '') + '" user_id="' + objUser.user_id + '">'
								+ '<div class="student_column" style="width:25px"><img src="<?php print $sn; ?>/imgs/v/src/' + (objUser.image_id ? objUser.image_id : '0.gif') + '/w/25/h/25" /></div>'
								+ '<div class="student_column" style="width:200px">' + objUser.strClassName + '</div>'
								+ '<div class="student_column" style="width:360px">' + objUser.first_name + ' ' + objUser.last_name + '</div>'
								+ '<div class="item_checked"></div>'
								+ '</div>');
							domUser.data('objUser', objUser);
							$('#student_list_pop .students_list').append(domUser);
						}
						$('#student_list_pop .students_list .student_row:not(.header)').click(function (e) {
							var parent = this;
							var intUser = $(parent).attr('user_id');
							var arrValues = $('.students .bar.associate_students').data('values');
							if ($(parent).hasClass('down')) {
								delete arrValues[intUser];
								$(parent).removeClass('down');
							} else {
								arrValues[intUser] = $(parent).data('objUser');
								$(parent).addClass('down');
							}
							$('.create_new .students .message_box span').html(Object.keys(arrValues).length);

						});
						$('.student_list_filter').focus();
					}
				}
			});
		}
	};
	KioskAnnouncementsApp.fnInit();
});
</script>
