	var KioskAnnouncementsApp = {
		'arrMemory' : {
			'arrTemplates' : {}
		},
		"arrGet" : <?php print json_encode($this->arrGet); ?>,
		'fnInit' : function () {
			var self = KioskAnnouncementsApp;
			self.fnLoadTemplates();
			$('.one_column .select .left_menu').click(function () {
				var objSelect = $(this).parent();
				var strItem = objSelect.attr('value');
				if (strItem == 'edit')
					return;
				$('.one_column .select.edit').addClass('hidden')
				$('.one_column .select.selected').removeClass('selected');
				objSelect.addClass('selected');
				$('.winner_display .title').html($(this).text());
				if (strItem == 'create') {
					$('.winner_display').addClass('hidden');
					$('.winner_display.create_new').removeClass('hidden');
					$('.create_new').attr('announcement_id', 'new');
					$('input.headline').focus().val('');
