<script language="javascript">
	function calculate_fees()
	{
		var intPrice = 0;
		var arrAddonPrices =  $('.addon_fee');	
		$("#price").val(0);
		for (var intKey=0; intKey != arrAddonPrices.length; intKey++)
		{
			var arrInputs = $(arrAddonPrices[intKey]).children();
			if($(arrInputs[0]).attr("checked"))
			{
				intPrice = parseFloat($(arrInputs[1]).val()) + parseFloat($("#price").val());
				$("#price").val(intPrice);
			}
		}
		$("#price").val(intPrice);
	}
	$(document).ready(function()
	{
		
		$('#form a.submit').click( function(e) {
			e.preventDefault();
			$.ajax({
				type : "POST",
				cache : false,
				start: $("#processing_status").html('Loading...').fadeIn("slow"),				
				url : '<?php echo $sn; ?>/packages/packageedit/package_id/<?php print $this->arrPackages[0]->pack_id ?>',
				dataType : "text",
				data: $('#form').serialize(),
				success : function(strResponse) {
					if (strResponse.match(/^[0-9]+$/)) {
						$("#processing_status").html("Save successful.").fadeIn("slow").delay(2000).fadeOut("slow");
					} else {
						$("#processing_status").html(strResponse).fadeIn("slow");
					}
				}
			});
		});
		
		$('#toggle_activation').click(function(e) {
			$.blockUI({ message: $('#question')});
		});
		
		// Activate / Deactivate
		$('#question #option1').click(function(e) {
			var strPath = "<?php echo $sn; ?>/administration/setstatus/id/<?php echo $this->arrPackages[0]->pack_id ?>/cat/packages/status/<?php
				echo $this->arrPackages[0]->active_pack
				? "deactivate"
				: "activate"; 
			?>";
			$("#processing_status").html('Loading...').fadeIn("slow");
			$.get(strPath, 
				function(strResponse) {
					if (!strResponse.match(/error|notice:/i)) {
						$("#processing_status").html(strResponse).fadeIn("slow").delay(500).fadeOut("slow").delay(500, function () {
							naviageBack($(".slider:last .slider_back"));
						});
					} else {
						$("#processing_status").html(strResponse).fadeIn("slow");
					}
				}
			);
			e.preventDefault();
			$.unblockUI();
		});
		
		$('#question #option2').click(function(e) {
			e.preventDefault();
			$.unblockUI();
		});
		
	});
</script>

