							<div class="clear"></div>
						</li>
						<li>
							<span class="label">Description:</span>
							<span class="input"><input type="text" class="required" id="description" name="description" value="<?php print $this->arrPackageItems[0]->description; ?>" size="25" minlength="2" /></span>
							<div class="clear"></div>
						</li>
						<li>
							<span class="label">Base Price:</span>
							<span class="input"><input type="text" class="required" id="price" name="price" value="<?php print $this->arrPackageItems[0]->price; ?>" size="25" minlength="2" /></span>
							<div class="clear"></div>
						</li>
						<li>
							<span class="label">Student Price:</span>
							<span class="input"><input type="text" class="required" id="student_price" name="student_price" value="<?php print $this->arrPackageItems[0]->student_price; ?>" size="25" minlength="2" /></span>
							<div class="clear"></div>
						</li>
						<li>
							<span class="label">Currency:</span>
							<span class="input"><input type="text" class="required" id="currency" name="currency" value="<?php print $this->arrPackageItems[0]->currency; ?>" size="25" minlength="2" /></span>
							<div class="clear"></div>
						</li>						
						<div id="processing_status"><?php if ($this->message) { echo $this->message . "<br>"; } ?></div>
