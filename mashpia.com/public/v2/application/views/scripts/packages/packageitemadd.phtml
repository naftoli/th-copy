<?php 
	include "config.phtml";
?>
<script>
$(document).ready(function()
{
	$('#formaddpackageitem a.submit').click( function(e) {
		e.preventDefault();
		$.ajax({
			type : "POST",
			cache : false,
			start: $("#processing_status").html('Loading...').fadeIn("slow"),
			url : '<?php echo $sn; ?>/packages/packageitemadd/host_id/<?=$this->host_id?>/network_id/<?=$this->network_id?>',
			dataType : "text",
			data: $('#formaddpackageitem').serialize(),
			success : function(response) {
				if (response.match(/^[0-9]+$/)) {
					$("#processing_status").html("Save successful.").fadeIn("slow").delay(2000).fadeOut("slow");
				} else {
					$("#processing_status").html(response).fadeIn("slow");
				}
			}
		});
	});
});
</script>
