<?php

	$strBarOrBat = $this->objUsers->gender == "M" ? "Bar" : "Bas";

	function TextToSingular ($strText)
	{
		$arrText = array(
			"yearly" => "year",
			"monthly" => "month",
			"weekly" => "week",
			"daily" => "day"
		);
		return $arrText[strtolower($strText)];
	}
?>

<script type="text/javascript">
function proc_overview() {
	var intLadder = $("#spinner-ladder-week :selected").val();
	var intStartingLines = $("#chapter_offset").val();
	$("#ladder_complete_learning").html(intLadder);
	$("#ladder_complete_lines").html(intStartingLines);
	$.ajax({
		type : "POST",
		cache : false,
		start: $("#campaing_batbar_status").html("Loading...").hide().fadeIn(),
		url : '<?php print WEB_ROOT . "kiosk-main/campaign-enroll/campaign_id/" . $this->objCampaign->campaign_id; ?>',
		dataType : "text",
		data: {
			"task_offset" : intStartingLines,
			"ladder" : intLadder
		},
		success : function(strResponse) {
			var objResult;
			try {
				objResult = jQuery.parseJSON(strResponse);
			} catch(e) {
				if (strResponse == "You must have a valid date of birth entered into the system for ladders to become available to you.")
				{
					alert("You must have a valid date of birth entered into the system for ladders to become available to you. Please contact your base comander to fix this problem.");
					history.go(-2);
				} else
					alert("Sorry, there was an error: VCE-PO101-S879DS");
				return;
			}
			//alert($.dump(objResult));
			$("#campaing_batbar_status").html(
				"<span id=\"ladder_complete_perek\">" + objResult.chapters + "</span> Perokim, "
				+ "<span id=\"ladder_complete_page\">" + objResult.pages + "</span> pages, "
				+ "<span id=\"ladder_complete_total\">" + objResult.line_number + "</span> lines "
				+ "<span class=\"ladder_text\"><br />of <?php print $this->objCampaign->campaign_name; ?> by heart.</span>"
			).hide().fadeIn();
		}
	});
}
// Wrote this to get the value of a spinner from the index
function spinnerValue($strSpinnerLink) {
	return $($($strSpinnerLink).spinner("value")[0]["innerHTML"])[$("#spinner-ladder-week").val()]["innerHTML"];
}
$(document).ready(function(){
	$("#slider").easySlider({
		numeric: true,
		controlsBefore:	'<div class="page_dots">',
		controlsAfter:	'</div>'
	});

	$("#spinner-ladder-week").change(function () {
		proc_overview();
	});

	$('.keypad').keypad();
	$('.scroll-pane').jScrollPane({showArrows:true, scrollbarWidth: 42, arrowSize: 42});

	$('#campaign_enroll_submit').click(function(e) {
		e.preventDefault();
		$.ajax({
			type : "POST",
			cache : false,
			start: $("#campaign_enroll_submit").html("Loading"),
			url : '<?php print WEB_ROOT . "kiosk-main/campaign-enroll/campaign_id/" . $this->objCampaign->campaign_id . "/enroll/true"; ?>',
			dataType : "text",
			data: {
				"task_offset" : $("#chapter_offset").val(),
				"ladder" : $("#spinner-ladder-week").val()
			},
			success : function(strResponse) {
				if (strResponse.match(/^[0-9]+$/)) {
					window.location.href = "<?php print WEB_ROOT . "kiosk-main/view-campaign/campaign_id/" . $this->objCampaign->campaign_id; ?>/lastaction/enrolled";
				} else {
					alert(strResponse);
				}
			}
		});
	});

	$('#chapter_offset').change(function(e) {
		e.preventDefault();
		proc_overview();
	});

	proc_overview();
});
</script>
