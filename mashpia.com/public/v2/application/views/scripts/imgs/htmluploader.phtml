		top.$(".slider:last #<?php print $this->strResultID; ?>", top.document).trigger("updated");
		$("#uploader_start_buttons").css({"visibility" : "visible"});
	}
	function uploadStart(file) {
		$("#smalluploader #lefttext").html("Uploading Image...");
		$("#uploader_start_buttons").css({"visibility" : "hidden"});
		$('#fsUploadProgress').css({'display' : 'block'});
		$('#photo_upload_table').removeClass('photo_upload_table');
		return true;
	}

	function fn_change_image() {
		$('#fsUploadProgress').css({'display' : 'none'});
		$('#photo_preview_table').css('display', 'none');
		$('#photo_upload_table').css('display', 'block');
		$('#photo_upload_table').addClass('photo_upload_table');
		$("#smalluploader #lefttext").html("Upload Image");
		$(".slider:last #<?php print $this->strResultID; ?>", top.document).val('');
	}
	function fn_set_image(strImageSrc) {
		if (strImageSrc == "0.jpg")
			return fn_change_image();
		$('#photo_preview_table').css('display', 'block');
		$('#photo_upload_table').css('display', 'none');
		$("#photo_preview_image").html("<img src='<?php print WEB_ROOT; ?>/imgs/v/w/<?php print $intCustomSize; ?>/h/<?php print $intCustomSize; ?>/src/" + strImageSrc + "' border='0' width='<?php print $intCustomSize; ?>' height='<?php print $intCustomSize; ?>' />");
	}
