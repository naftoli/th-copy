			.css({
				position : 'absolute',
				opacity : 0,
				top : -10000,
				left : 0,
				'z-index' : 10000
			}).iframe();
			$(domIframe)
			.contents()
			.find('body')
			.append('<form enctype="multipart/form-data" method="post"></form>')
			.find('form')
			.attr('action', '<?php print WEB_ROOT; ?>imgs/uploadprocess2')
			.append('<input type="hidden" name="upload" value="true" />')
			.append('<input type="file" name="file" value="_" />')
			.find('input')
			.bind('change', function () {
				$(this).closest('form').trigger('submit');
				$('#image_uploader_button').val($('#image_uploader_button').attr('loading_msg'));
			})
			.trigger('click');
		});
	});
	function uploadSuccessCust(file, serverData) {
		$("#photo_upload_table").css("display", "none");
		$('#photo_preview_table').css('display', 'block');
		if ($("#photo_preview_image img").attr("src") != "<?php print WEB_ROOT; ?>/imgs/v/w/<?php print $intCustomSize; ?>/h/<?php print $intCustomSize; ?>src/" + serverData)
			$("#photo_preview_image").html("<img src='<?php print WEB_ROOT; ?>/imgs/v/w/<?php print $intCustomSize; ?>/h/<?php print $intCustomSize; ?>/src/" + serverData + "' border='0' width='<?php print $intCustomSize; ?>' height='<?php print $intCustomSize; ?>' />");
