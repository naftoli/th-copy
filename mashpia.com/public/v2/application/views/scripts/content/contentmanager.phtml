				var strTotalType = $('.slider:last .display_manual_change .total_type').val();
				var strCalcType = $('.slider:last .display_manual_change .calc_type').val();
				var boolStore = strTotalType.match(/store/);
				var boolTotal = strTotalType.match(/total/);
				var intAmount = $('.slider:last .display_manual_change .amount').val();
				if (strCalcType == "subtract")
					intAmount = -intAmount;
				if (
					(
						boolStore
						&& intStore >= 0
						&& intStore + intAmount < 0
					) || (
						boolTotal
						&& intTotal >= 0
						&& intTotal + intAmount < 0
					)
				) {
					$('.slider:last .display_manual_change .msg.top').removeClass("hidden").html("Warning: This student will be left with a negative balance.");
