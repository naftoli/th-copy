			});
			$(".slider:last .button.next").click(function () {
				if (AdminUsersTransactions.intTotalPages <= AdminUsersTransactions.intCurrentPage+1)
					return;
				AdminUsersTransactions.intCurrentPage++;
				AdminUsersTransactions.fnAjaxLoad();
			});
			$(".slider:last .button.prev").click(function () {
				if (0 > AdminUsersTransactions.intCurrentPage - 1)
					return;
				AdminUsersTransactions.intCurrentPage--;
				AdminUsersTransactions.fnAjaxLoad();
			});

		},
		"fnInit" : function () {
			AdminUsersTransactions.fnOutterBind();
			AdminUsersTransactions.fbInnerBind();
		},
		'method_row_add_new' : function () {
			if ($(".slider:last .row_add_new").hasClass("fakehidden")) {
