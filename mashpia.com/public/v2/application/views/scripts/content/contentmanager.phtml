				var intUserPoints = AdminUsersTransactions.arrPointSums.store;
				for (var intPrize in arrList)
				{
					if (arrList[intPrize].prize_id)
					{
						intTotal += arrList[intPrize].miles_total * arrList[intPrize].quantity;
					}
				}
				// not displaying total after input update from slider
				if (intTotal*1 != 0)
					$(".slider.sub_slider1:last .prize_totals.cost").removeClass("hidden").find(".miles").html(intTotal);
				else
				{
					$(".slider.sub_slider1:last .prize_totals").addClass("hidden");
					return;
				}
				var intRemainder = intUserPoints - intTotal;
				if (intRemainder < 0)
				{
					$(".slider.sub_slider1:last .prize_totals.over").removeClass("hidden").find(".miles").html(intRemainder.toString().replace(/-/,''));
				}
				else
				{
					$(".slider.sub_slider1:last .prize_totals.over").addClass("hidden");
				}
			});

