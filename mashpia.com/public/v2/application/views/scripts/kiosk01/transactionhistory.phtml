<script type="text/javascript">
$(document).ready(function () {
	var KioskListApp = {
		"arrPageData" : <?php print json_encode($this->arrResult); ?>,
		"arrParams" : {
			"display_type" : "all",
			"campaign_type" : "all",
			"items_per_page" : <?php print $this->intItemsPerPage; ?>,
			"navigate_to" : 0
		},
		"fn_load_page" : function ()
		{
			var arrPost = KioskListApp.arrParams;
			var arrLastRequest = KioskListApp.arrPageData;
			// remove row data from postback
			delete arrLastRequest.rows;
			arrPost.arrPostBack = arrLastRequest;
			arrPost.output = "json";
			var strPageNumber = Math.ceil((KioskListApp.arrParams.navigate_to-1) / KioskListApp.arrParams.items_per_page)+1;
			$("#pageDisplay").html("<?php print text("Loading Page"); ?> " + strPageNumber + " <?php print text("of"); ?> " + Math.ceil(KioskListApp.arrPageData.items_count / KioskListApp.arrParams.items_per_page) + "...");
			//alert(KioskListApp.arrParams.navigate_to);
			//$("#list_pane .loading").fadeIn();
			$.ajax({
				type : "POST",
				cache : false,
				url : '<?php print $sn . "/kiosk01/transactionhistory" . $strParamPath; ?>',
				dataType : "text",
				data: arrPost,
				success : function(strResponse) {
					//$("#list_pane .loading").fadeOut();
					try {
						var arrResponse = jQuery.parseJSON(strResponse);
					} catch(e) {
						$(".slider:last #processing_status").html('<?php print text("Sorry, there was an error"); ?>: VHS-TH101-564262');
						$.dumper(strResponse);
						return;
					}
					if (typeof(arrResponse) != "object") {
						$(".slider:last #processing_status").html('<?php print text("Sorry, there was an error"); ?>: VHS-TH102-853235');
						$.dumper(strResponse);
						return;
					} else {
						if (arrResponse["error"]) {
							$(".slider:last #processing_status").html('<?php print text("Sorry, there was an error"); ?>: VHS-TH103-414245');
							$.alert(arrResponse);
						} else {
							//$.alert(arrResponse);
							KioskListApp.arrParams.navigate_to = KioskListApp.arrPageData.first_row_number;
							KioskListApp.arrPageData = arrResponse;
							KioskListApp.fn_init_page();
						}
					}
				}
			});
		},
		"fn_init_page" : function () {
			$("#list_pane").find(".row.cloned").remove();
			var arrRows = KioskListApp.arrPageData.rows;
			//$.dumper(KioskListApp.arrPageData);
			var strPageNumber = Math.floor((KioskListApp.arrPageData.first_row_number-1) / KioskListApp.arrParams.items_per_page)+1;
			$("#pageDisplay").html("<?php print text("Page"); ?> " + strPageNumber + " <?php print text("of"); ?> " + Math.ceil(KioskListApp.arrPageData.items_count / KioskListApp.arrParams.items_per_page));
			$("#table_showing").html("<?php print text("Showing"); ?> " + KioskListApp.arrPageData.first_row_number + "-" + (KioskListApp.arrPageData.last_row_number-1) + " <?php print text("of"); ?> " + KioskListApp.arrPageData.items_count);
			//$.alert(arrRows);
			for (var strRowKey in arrRows)
			{
				if (arrRows[strRowKey].prize) {
					var domRow = $("#list_pane .prize_purchase.template").clone();
					$(domRow).css("display", "block");
					$(domRow).removeClass("template");
					$(domRow).addClass("cloned");
					var strImage = arrRows[strRowKey].prize.image_id;
					if (strImage == "0" || !strImage)
						strImage = "<?php print $this->objInstitution->image_id; ?>";
					$(domRow).find(".ph_prize_image img").attr("src", "<?php print $sn; ?>/imgs/v/src/" + strImage);
					$(domRow).find(".ph_prize_name").html(arrRows[strRowKey].prize.prize_name);
					$(domRow).find(".ph_transaction_date").html(arrRows[strRowKey].transaction_date);
					$(domRow).find(".ph_transaction_time").html(arrRows[strRowKey].transaction_time);
					$(domRow).find(".ph_prize_cost").html(arrRows[strRowKey].prize.points);
					$(domRow).find(".ph_sum_cost").html(-(arrRows[strRowKey].user_point.points));
					$(domRow).find(".ph_quantity").html(arrRows[strRowKey].user_prize.quantity);
					$(domRow).find(".ph_store_miles").html(arrRows[strRowKey].store_points);
					$(domRow).find(".ph_total_miles").html(arrRows[strRowKey].total_points);
					$("#list_pane .loading").after(domRow);
					//$.alert(arrRows[strRowKey]);
				}
				else if (arrRows[strRowKey].admin)
				{
					var domRow = $("#list_pane .admin_manual.template").clone();
					$(domRow).css("display", "block");
					$(domRow).removeClass("template");
					$(domRow).addClass("cloned");
					var strImage = ""; //arrRows[strRowKey].admin.image_id;
					if (strImage == "" || !strImage)
						strImage = "<?php print $this->objInstitution->image_id; ?>";
					//$.alert(strImage);
					$(domRow).find(".ph_admin_image img").attr("src", "<?php print $sn; ?>/imgs/v/src/" + strImage);
					$(domRow).find(".ph_admin_name").html(arrRows[strRowKey].admin.first_name + " " + arrRows[strRowKey].admin.last_name);
					$(domRow).find(".ph_transaction_date").html(arrRows[strRowKey].transaction_date);
					$(domRow).find(".ph_transaction_time").html(arrRows[strRowKey].transaction_time);
					// only say it was store miles if it was a deductions since adding is the same for both
					if (arrRows[strRowKey].user_point.resource_name == "admin_users_manual_store" && arrRows[strRowKey].user_point.points < 0)
						$(domRow).find(".ph_deduction_type").html("<?php print text("store"); ?>");
					else
						$(domRow).find(".ph_deduction_type").html("");
					$(domRow).find(".ph_amount").html(arrRows[strRowKey].user_point.points < 0 ? -(arrRows[strRowKey].user_point.points) : arrRows[strRowKey].user_point.points);
					if (arrRows[strRowKey].user_point.resource_name == "direct_transfer")
						$(domRow).find(".ph_amout_type").html("<?php print text("In Class Award"); ?>");
					else
						$(domRow).find(".ph_amout_type").html("<?php print text("Manually"); ?>" + (arrRows[strRowKey].user_point.points < 0 ? "<?php print text("Deducted"); ?>" : "<?php print text("Awarded"); ?>"));
					$(domRow).find(".ph_store_miles").html(arrRows[strRowKey].store_points);
					$(domRow).find(".ph_total_miles").html(arrRows[strRowKey].total_points);
					$("#list_pane .loading").after(domRow);
				}
				else if (arrRows[strRowKey].achievement_card)
				{
					var domRow = $("#list_pane .achievement_card.template").clone();
					$(domRow).css("display", "block");
					$(domRow).removeClass("template");
					$(domRow).addClass("cloned");
					var strImage = arrRows[strRowKey].campaign ? arrRows[strRowKey].campaign.image_id : "";
					if (strImage == "" || !strImage)
						strImage = "<?php print $this->objInstitution->image_id; ?>";
					$(domRow).find(".ph_campaign_image img").attr("src", "<?php print $sn; ?>/imgs/v/src/" + strImage);
					$(domRow).find(".ph_campaign_name").html(arrRows[strRowKey].campaign ? arrRows[strRowKey].campaign.campaign_name : "n/a");
					$(domRow).find(".ph_task_name").html(arrRows[strRowKey].task ? arrRows[strRowKey].task.task_name : "n/a");
					$(domRow).find(".ph_transaction_date").html(arrRows[strRowKey].transaction_date);
					$(domRow).find(".ph_transaction_time").html(arrRows[strRowKey].transaction_time);
					$(domRow).find(".ph_miles_awarded").html(arrRows[strRowKey].user_point.points < 0 ? -(arrRows[strRowKey].user_point.points) : arrRows[strRowKey].user_point.points);
					$(domRow).find(".ph_store_miles").html(arrRows[strRowKey].store_points);
					$(domRow).find(".ph_total_miles").html(arrRows[strRowKey].total_points);
					$("#list_pane .loading").after(domRow);
				}
			}
		},
		"fn_init_ui" : function ()
		{
			KioskListApp.arrParams.navigate_to = KioskListApp.arrPageData.first_row_number;
			$(".one_column .select a").click(function () {
				$('#backdrop').fadeTo('normal', 0.7);
				$(".overlay." + $(this).closest(".select").attr("id")).fadeIn();
				$('#overlay_parent').css({
					"top" : Math.max(0, (($('body').height()-430)/2)) + 'px',
					"display" : "block"
				});
			});

			$("#pager .next").click(function () {
				if (parseInt(KioskListApp.arrPageData.first_row_number)+parseInt(KioskListApp.arrParams.items_per_page) <= KioskListApp.arrPageData.items_count)
				{
					KioskListApp.arrParams.navigate_to = parseInt(KioskListApp.arrPageData.first_row_number)+parseInt(KioskListApp.arrParams.items_per_page);
					KioskListApp.fn_load_page();
				}
			});
			$("#pager .prev").click(function () {
				if (KioskListApp.arrPageData.first_row_number > KioskListApp.arrParams.items_per_page)
				{
					KioskListApp.arrParams.navigate_to = parseInt(KioskListApp.arrPageData.first_row_number)-parseInt(KioskListApp.arrParams.items_per_page);
					KioskListApp.fn_load_page();
				}
			});

			$('.close_overlay').bind('click', function(event) {
				$('#backdrop').fadeTo('normal', 0).queue(function () {
					$(this).dequeue().css("display", "none");
				});
				$(".overlay").fadeOut();
			});

			$(".selecton_box").mouseover(function () {
				$(this).css({"background" : "rgba(255, 255, 255, 0.3)"});
			});
			$(".selecton_box").mouseout(function () {
				$(this).css({"background" : "rgba(255, 255, 255, 0.1)"});
			});
			$(".overlay .selecton_box").click(function () {
				var strOverlayType = $(this).closest(".overlay").attr("id").replace(/_overlay/, '');
				$('#backdrop').fadeTo('normal', 0).queue(function () {
					$(this).dequeue().css("display", "none");
				});
				$(".overlay").fadeOut();
				$(".one_column ." + $(this).closest(".overlay").attr("id") + " .option").html($(this).html());
				if (strOverlayType == "campaign_type" && $(this).attr("value") != "all") {
					$(".one_column .display_type_overlay .option").html("<?php print text("Points"); ?>");
					KioskListApp.arrParams["display_type"] = "points";
				}
				if (strOverlayType == "display_type") {
					$(".one_column .campaign_type_overlay .option").html("<?php print text("All"); ?>");
					KioskListApp.arrParams["campaign_type"] = "all";
				}
				KioskListApp.arrParams[strOverlayType] = $(this).attr("value");
				KioskListApp.arrPageData.first_row_number = 1;
				KioskListApp.arrParams.navigate_to = 1;
				KioskListApp.fn_load_page();
			});
			// content already preloaded, build the page
			KioskListApp.fn_init_page();
		}
	};
	KioskListApp.fn_init_ui();
});
</script>
