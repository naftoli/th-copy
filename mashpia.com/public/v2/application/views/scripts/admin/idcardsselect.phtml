<script>
$(function () {
	$('.slider:last .ph_prize_sent').click(function () {
		$.ajax({
			type : "POST",
			cache : false,
			start: $(".slider:last .ph_bottom_status").html("Loading...").fadeIn(),
			url : '<?php echo $sn . "/admin/markprinted" . $strParamPath; ?>',
			dataType : "text",
			data: "user_ids=" + Object.keys(objUsersMenu.arrSelected).join(','),
			success : function(strResponse) {
				try {
					var arrResponse = jQuery.parseJSON(strResponse);
				} catch(e) {
					alert("Sorry, there was an error: VU-IDCHN101-DF9GF9");
					$.dumper(strResponse);
					return;
				}
				if (typeof(arrResponse) != "object") {
					alert("Sorry, there was an error: VU-IDCHN102-DOPSDO");
					$.dumper(strResponse);
					return;
				} else {
					if (arrResponse["error"]) {
						$(".slider:last .ph_bottom_status").html(arrResponse["error"]);
					} else if (arrResponse["success"] == "true") {
						$(".slider:last .ph_bottom_status").html("Success!").fadeOut();
					}
				}
			}
		});
	});
	$('#slider_idcards .fn_print_locally').bind("click", function () {
		$("#slider_idcards #idcard_section1 .user_ids").val(Object.keys(objUsersMenu.arrSelected).join(","));
		$("#slider_idcards #idcard_section1 form")
			.attr("action", "<?php print bp;?>/admin/idcardshostprintcamps<?php print $strParamPath; ?>");
		$("#slider_idcards #idcard_section1 form").submit();
	});
	$('#slider_idcards .fn_printqr_locally').bind("click", function () {
		$("#slider_idcards #idcard_section1 .user_ids").val(Object.keys(objUsersMenu.arrSelected).join(","));
		$("#slider_idcards #idcard_section1 form")
			.attr("action", "<?php print bp;?>/admin/idcardshostprintcampsqr<?php print $strParamPath; ?>");
		$("#slider_idcards #idcard_section1 form").submit();
	});
});
</script>