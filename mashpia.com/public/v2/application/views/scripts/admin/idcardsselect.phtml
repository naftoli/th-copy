<script>
	// used in usersselect
	var objUsersMenu = {};

	function usersselect_callback() {
		var arrUserIds = Object.keys(objUsersMenu.arrSelected);
		var mixedAmount = arrUserIds.length;
		if (!arrUserIds.length)
			mixedAmount = "None";
		$("#slider_idcards .lable_count span").html(mixedAmount);

		if (arrUserIds) {
			$("#slider_idcards #idcard_section2").fadeIn();
		} else {
			$("#slider_idcards #idcard_section2").fadeOut();
		}

		var strHtml = "";
		if (!$("#slider_idcards #secondlist_header").length)
		{
			strHtml += '<li id="secondlist_header"><div class="title"><?php print text("Name"); ?></div>';
			strHtml += '<div style="float:right;padding-top:2px">&nbsp;</div>';
			strHtml += '<div class="extrabox" style="width:50px"><?php print text("Photo"); ?></div>';
			strHtml += '<div class="extrabox" style="width:140px"><?php print text("[|Registered|]"); ?></div>';
			strHtml += '<div class="extrabox"><?php print text("Printed"); ?></div>';
			strHtml += '</li>';
		}
		$("#slider_idcards #idcard_section2 .removeable_selection_list ul li").remove();
		for (var intUser in objUsersMenu.arrSelected)
		{
			var objUser = JSON.parse(objUsersMenu.arrSelected[intUser]);
			strHtml += '<li id="selected_' + intUser + '"><div class="title">' + objUser.first_name + ' ' + objUser.last_name + '</div>';
			strHtml += '<input type="hidden" class="user_id" value="' + intUser + '" />';
			strHtml += '<div style="float:right;padding-top:2px"><span><a class="button fn_remove_selection"><?php print text("Remove Selection"); ?></a></span></div>';
			strHtml += '<div class="extrabox" style="width:50px">' + (objUser.image_id ? 'Yes' : 'No') + '</div>';
			strHtml += '<div class="extrabox" style="width:140px">' + objUser.registered + '</div>';
			strHtml += '<div class="extrabox col_status">' + objUser.ordered + '</div>';
			strHtml += '</li>';
		}
		$("#slider_idcards #idcard_section2 .removeable_selection_list ul").append(strHtml);

		// Remove second list item
		$("#slider_idcards .fn_remove_selection").bind("click", function () {
			var objLi = $(this).closest("li");
			var intUser = objLi.find(".user_id").val();

			delete objUsersMenu.arrSelected[intUser];

			objLi.fadeOut().queue(function () {
				$(this).dequeue().remove();
			});
			var intUsers = Object.keys(objUsersMenu.arrSelected).length;
			$("#slider_idcards .selected_user_count").html();
			if (intUsers)
				$("#slider_idcards #idcard_section2").fadeIn();
			else
			{
				$("#slider_idcards #idcard_section2").fadeOut();
			}
			var arrUserIds = Object.keys(objUsersMenu.arrSelected);
			mixedAmount = arrUserIds.length;
			if (!arrUserIds.length)
				mixedAmount = "None";
			$("#slider_idcards .lable_count span").html(mixedAmount);
		});
	}
</script>
