<script tyoe="text/javascript">
	var prevSlider = $(".slider:last").prev();
	if (!prevSlider.length)
		$.alert("Could not find previous slider");
	if (!$(prevSlider).find('#<?php print $strDivContainer; ?>').length)
		$.alert("Could not find previous slider div container `#<?php print $strDivContainer; ?>`");
	if (!$(prevSlider).find('#<?php print $strDivContainer; ?> #<?php print $strHiddenInputName; ?>').length)
		$.alert("Could not find input item on previous slider `#<?php print $strHiddenInputName; ?>`");
	var strSerializedData = $(prevSlider).find('#<?php print $strDivContainer; ?> #<?php print $strHiddenInputName; ?>').val();
	var arrSerializedData = strSerializedData.split(new RegExp("&"));
	for (intItr in arrSerializedData)
	{
		var arrKeyVal = arrSerializedData[intItr].split(new RegExp(" *= *"));
		if (arrKeyVal[1])
		{
			row_toggle($('.slider:last form input[name="' + arrKeyVal[0] + '"]').closest(".row"), 0);
		}
	}
</script>