    "react": "^16.14.0",
    "react-credit-cards": "^0.7.0",
    "react-csv": "^1.0.19",
    "react-datepicker": "^1.5.0",
    "react-dev-utils": "^12.0.0",
    "react-dom": "^16.9.0",
    "react-jewish-datepicker": "^1.2.1",
    "react-jss": "^10.5.0",
