
RewriteEngine on
RewriteCond %{HTTP_HOST} ^m\.mashpia\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.m\.mashpia\.com$
RewriteRule ^/?$ "http\:\/\/mashpia\.com\/mobile\/" [R=301,L]

