<script type="text/javascript">
	$(document).ready(function(){
		var itemSize = 44;
		var intNumberOfRows = Math.ceil(<?php print count($this->distinctPrizes); ?> / 2) - 8;
		if (intNumberOfRows < 0)
			intNumberOfRows = 0;
		var intMaxHeight = -(intNumberOfRows * itemSize);
		if (intMaxHeight >= 0)
		{
			$("#btn_box").css("display", "none");
		}
		var intCurrentHeight = 0;
		$("a#button_dn").click(function () {
			var currentTop = intCurrentHeight - (itemSize * 2);
			if (intCurrentHeight > intMaxHeight) {
				$("#cat_box").animate({"top":currentTop});
				intCurrentHeight = currentTop;
			}
		});
		$("a#button_up").click(function () {
			var currentTop = intCurrentHeight + (itemSize * 2);
			if (intCurrentHeight != 0) {
				$("#cat_box").animate({"top":currentTop});
				intCurrentHeight = currentTop;
			}
		});
	 });
</script>
