function getCartItemQuantity($cartItems, $intPrizeId)
{
	$intQuantity = 0;

	foreach ($cartItems as $cartItem) {
		if ($cartItem->prize_id == $intPrizeId)
		{
			$intQuantity = $cartItem->quantity;
			break;
		}
	}

	echo $intQuantity;
}
