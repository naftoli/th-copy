<script type="text/javascript">
function row_toggle(objThis,boolProcessChange)
{
	if ($(objThis).is("input"))
		return;
	$(objThis).find(":checkbox").attr("checked", !$(objThis).find(":checkbox").is(':checked')).trigger("change");
	$(objThis).css("background-color", $(objThis).find(":checkbox").is(':checked') ? "#dadee6" : "#e8eaef");
	if (boolProcessChange)
		process_change();
}
function uncheckall(objThis)
{
	$(objThis).closest(".module_collection").find(":checkbox").attr("checked", false);
	$(objThis).closest(".module_collection").find(".module table .row").css("background-color", "#e8eaef").trigger("change");
	process_change();
}
function checkall(objThis)
{
	$(objThis).closest(".module_collection").find(":checkbox").attr("checked", true);
	$(objThis).closest(".module_collection").find(".module table .row").css("background-color", "#dadee6").trigger("change");
	process_change();
}
function process_change()
{
	var prevSlider = $(".slider:last").prev();
	var intSelected = $(".slider:last input:checkbox:checked").length;
	$(prevSlider).find('<?php print $this->strInputPath; ?>').html(intSelected + " Prize" + (intSelected == 1 ? '' : 's') + " Selected");
	var objDataPoint = $(prevSlider).find('<?php print $this->strInputPath; ?>_hidden');
	// construct data
	var arrInputs = $.makeArray($(".slider:last form").serializeArray());
	var arrData = {};
		for (var intKey in arrInputs)
	{
		var arrMatched = arrInputs[intKey].name.match(/^(.+?)_([0-9]+)$/);
		var intRow = arrMatched[2];
		var intCol = arrMatched[1];
		if (!arrData[intRow])
			arrData[intRow] = {};
		arrData[intRow][intCol] = arrInputs[intKey].value;
	}
	var intMilesTotal = 0;
	for (var intRow in arrData)
	{
		if (arrData[intRow].prize_id)
		{
			intMilesTotal+=arrData[intRow].miles_total*arrData[intRow].quantity;
		}
	}
	$(".slider:last .miles_total").html(intMilesTotal);

	var strSeriaized = JSON.stringify(arrData);
	if (strSeriaized != objDataPoint.val())
	{
		objDataPoint.val(strSeriaized).trigger("change");
	}
}
$(document).ready(function () {
	$(".slider:last input.input").change(function () {
		if ($(this).val()*1 < 1)
		{
			$(this).val(0);
			if ($(this).closest("tr").find(".key").is(":checked")) {
				row_toggle($(this).closest("tr"),1);
			}
		} else {
			if (!$(this).closest("tr").find(".key").is(":checked")) {
				row_toggle($(this).closest("tr"),1);
			}
			if ($(this).val()*1 > $(this).closest("tr").find(".in_stock").val()*1)
				$(this).val($(this).closest("tr").find(".in_stock").val());
			process_change();
		}
	});
	$(".slider:last input.input").keydown(function (event) {
		//
		if (
			!(event.which >= 48 && event.which <= 57) // numbers
			&& !(event.which >= 96 && event.which <= 105) // numbers
			&& !(event.which == 8 || event.which == 9 || event.which == 16 || event.which == 46)
			&& !(event.which == 36 || event.which == 35  || event.which == 34 || event.which == 33 || event.which == 17)
			&& !(event.which >= 37 && event.which <= 40) // arrows
		) {
			event.preventDefault();
		}
	});
	$(".slider:last .key").change(function () {
		if ($(this).is(":checked"))
		{
			if ($(this).closest("tr").find(".quantity").val()*1 < 1)
				$(this).closest("tr").find(".quantity").val(1);
		}
	});
});
