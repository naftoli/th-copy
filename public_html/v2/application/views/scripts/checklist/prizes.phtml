<script type="text/javascript">
var prevSlider = $(".slider:last").prev();
var strSerializedData = $(prevSlider).find('<?php print $this->strInputPath; ?>_hidden').val();
if (strSerializedData.length)
{
	var arrSerializedData = JSON.parse(strSerializedData);
	for (intItem in arrSerializedData)
	{
		if (arrSerializedData[intItem].prize_id)
		{
			row_toggle($('.slider:last form input.key_' + intItem).closest(".row"), 0);
			for (var strKey in arrSerializedData[intItem])
			{
				var objKeyItems = $(".slider:last ." + strKey + "_" + arrSerializedData[intItem].prize_id);
				if (objKeyItems.length) {
					objKeyItems.val(arrSerializedData[intItem][strKey]);
				}
			}
		}
	}
}
process_change();
</script>