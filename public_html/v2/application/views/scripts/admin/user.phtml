<script>
	$(function () {
		$('.slider:last form a.delete_user').click (function () {
			if (confirm("Are you sure you want to delete this user?"))
				$.ajax({
					type : "POST",
					cache : false,
					start : $(".slider:last #processing_status").html('Loading...').fadeIn(),
					url : '<?php echo $sn . "/admin/deleteuser" . $strParamPath; ?>',
					dataType : "text",
					data : $('.slider:last form').serialize(),
					success : function(strResponse) {
						try {
							var arrResponse = jQuery.parseJSON(strResponse);
						} catch(e) {
							alert("<?php print text("Sorry, there was an error"); ?>: VU-U103-f23fes");
							$.alert(strResponse);
							return;
						}
						if (typeof(arrResponse) != "object") {
							alert("<?php print text("Sorry, there was an error"); ?>: VU-U104-2ffef3");
							$.alert(strResponse);
							return;
						} else {
							$(".slider:last #processing_status").fadeOut();
							if (arrResponse["error"]) {
								$(".slider:last #processing_status").html(arrResponse["error"]).fadeIn();
							} else if (arrResponse["success"] == "true") {
								$(".slider:last #processing_status").html("User deleted.").fadeIn("slow");
							} else {
								alert("Unexpected error: VA-U105-11c12c");
								$.alert(arrResponse);
							}
						}
					}
				});
		});
		$('.slider:last form a.submit.save').click( function(e) {
			$(".slider:last .processing_status").fadeOut();
			$.ajax({
				type : "POST",
				cache : false,
				start : $(".slider:last #processing_status").html('Loading...').fadeIn(),
				url : '<?php echo $sn . "/admin/user" . $strParamPath; ?>',
				dataType : "text",
				data : $('.slider:last form').serialize(),
				success : function(strResponse) {
					try {
						var arrResponse = jQuery.parseJSON(strResponse);
					} catch(e) {
						alert("<?php print text("Sorry, there was an error"); ?>: VU-U101-3RR3RE");
						$.alert(strResponse);
						return;
					}
					if (typeof(arrResponse) != "object") {
						alert("<?php print text("Sorry, there was an error"); ?>: VU-U102-SDF8BX");
						$.alert(strResponse);
						return;
					} else {
						$(".slider:last #processing_status").fadeOut();
						if (arrResponse["error"]) {
							if (typeof(arrResponse["error"]) != "object") {
								$(".slider:last #processing_status").html(arrResponse["error"]).fadeIn();
							} else {
								for (strField in arrResponse["error"])
								{
									//alert($.dump($(".slider:last #" + strField).closest("li").html()));return;
									$(".slider:last #" + strField).closest("li").next().html(arrResponse["error"][strField]).fadeIn();
								}
							}
						} else if (arrResponse["success"] == "true") {
							$(".slider:last #processing_status").html("Save successful").fadeIn("slow").delay(2000).fadeOut("slow");
						} else {
							alert("Unexpected error: VA-U101-f1fno2f");
							$.alert(arrResponse);
						}
					}
				}
			});
		});
	});
</script>
