<script language="javascript">
$(document).ready(function()
{
	var objTimeout = false;
	var strPricing = 'general_package';
	$('.pricing_options_input').change(function () {
		var arrData = $('body').data("reg_data");
		strPricing = $(this).attr('id');
		$('#registration_kioskaccessories .pricing_scale').addClass('hidden');
		$('#registration_kioskaccessories .pricing_scale.' + strPricing).removeClass('hidden');
		$('.slider:last #kioskaccessories_campers').trigger('keyup');
		arrData.package_option = strPricing;
		$('body').data("reg_data", arrData);
	});
	$('.slider:last form').keyup(function (e) {
		var charCode = (e.which) ? e.which : e.keyCode;
		if (charCode == 13) {
			e.preventDefault();
			if ($(this).find('.submit').length)
				$(this).find('.submit').click();
			else
				$(this).submit();
		}

	});

	var arrRegData = $('body').data("reg_data");
	for (var strKey in arrRegData)
	{
		$(".slider:last #" + strKey).val(arrRegData[strKey]);
	}
	$('.slider:last .submit').click(function(){
		var strURL = '<?php print $sn . "/registration/payment" . $strParamPath; ?>';
		slideURL(strURL);
	});

	$("#registration_kioskaccessories input[type=text]").bind("keyup", function() {
		var intTotal = kiosk_accessories_sum();
		$("#kioskaccessories_total").html(intTotal);
		window.clearTimeout(objTimeout);
		objTimeout = window.setTimeout(function () {
			var arrData = $('body').data("reg_data");
			if (!arrData)
				arrData = {};
			var arrNewData = $('.slider:last form').serializeArray();
			for (var intItr in arrNewData)
			{
				arrData[arrNewData[intItr]["name"]] = arrNewData[intItr]["value"];
			}
			$('body').data("reg_data", arrData);
		}, 100);
	});

	var intTotal = kiosk_accessories_sum();
	$("#kioskaccessories_total").html(intTotal);
	$('.slider:last .xmin').change(function () {
		if (!parseInt($(this).val()) || parseInt($(this).val()) < parseInt($(this).attr('min'))) {
			$(this).val($(this).attr('min'));
			$(this).trigger('keyup');

		}
	});
	$('.slider:last #kioskaccessories_campers').keyup(function () {
		var intVal = parseInt($(this).val());
		if (intVal < 10 || !parseInt($(this).val()))
			intVal = 10;
		if (strPricing == 'general_package')
		{
			var intCost = 10;
			var arrCosts = {
				0 : 10,
				51 : 9,
				76 : 8,
				101 : 6,
				201 : 5,
				501 : 4
			};
		} else {
			var intCost = 12;
			var arrCosts = {
				0 : 12,
				51 : 10,
				76 : 8,
				101 : 7,
				201 : 6,
				501 : 5
			};
		}
		for (var intAmount in arrCosts) {
			if (intVal >= intAmount)
				intCost = arrCosts[intAmount];
		}/*
		if (intVal > 83 && intVal < 100) {
			intCost = arrCosts[100];
			intVal = 100;
		} else if (intVal > 262 && intVal < 300) {
			intCost = arrCosts[300];
			intVal = 300;
		} else if (intVal > 428 && intVal < 500) {
			intCost = arrCosts[500];
			intVal = 500;
		}*/
		$(this).attr('price', intCost);
		$('.slider:last .campers.cost.amount').html('$'+intCost);
		$('.slider:last .campers.total .sum.amount').html('$'+(intCost*intVal));
		arrRegCalc[$(this).attr('name')] = (intCost*intVal);
		var intTotal = kiosk_accessories_sum();
		$("#kioskaccessories_total").html(intTotal);
	});
	$("#registration_kioskaccessories input[type=text]").trigger('keyup');
});

function kiosk_accessories_sum()
{
	var arrItems = $("#registration_kioskaccessories input[type=text].auto_calcuate");
	for (var intItr=0; intItr!=arrItems.length; intItr++)
	{
		var objItem = arrItems[intItr];
		var intAmount = $(objItem).val();
		if ($(objItem).attr('min') > intAmount)
			intAmount = $(objItem).attr('min');
		if (!$(objItem).attr("price"))
			continue;
		var intVal = parseInt($(objItem).attr("price") * intAmount);
		if (isNaN(intVal))
		{
			var arrIntFound = intAmount.match(/([$,\.0-9]+)/);
			intAmount = arrIntFound[1] * 1;
			$(objItem).val(intAmount);
			intVal = parseInt($(objItem).attr("price") * intAmount);
		}
		//if (intAmount !== intAmount*1)
		//	$(objItem).val(intAmount*1);
		if (!isNaN(intVal))
		{
			if ($(objItem).attr('id') == 'kioskaccessories_scanner')
			{
				if (intAmount>0) {
					intVal += Math.floor(((intAmount*1)-1) / 3) * 2.50;
					intVal += 2.5;
				}
			}
			if ($(objItem).attr('id') == 'kioskaccessories_handbook')
			{
				if (intAmount>0) {
					intVal += Math.floor(((intAmount*1)-1) / 50) * 2.50;
					intVal += 2.5;
				}
			}
			arrRegCalc[$(objItem).attr('name')] = intVal;
			$(objItem).closest('.table_labels').find('.sum.amount').html("$"+intVal);
		}
	}
	var intTotal = 0;
	for (var strName in arrRegCalc) {
		intTotal += arrRegCalc[strName];
	}
	return intTotal;
}
