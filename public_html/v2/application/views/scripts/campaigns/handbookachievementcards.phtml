			intTopMargin : $('.slider:last input.top_margin').val(),
			intRowMargin : $('.slider:last input.row_margin').val()
		};
		var strUrl = '<?php print $sn; ?>/campaigns/pointcardsetsprintoutput/dataparams/' + encodeURIComponent(JSON.stringify(arrDataParams));
		window.open(strUrl, '_blank');
	});
