<script language="javascript">
	if ($('.slider:last .accordion.closed li h3').closest('li').hasClass('open')) {
		$('.slider:last .accordion.closed li h3').nextAll().slideToggle(0);
		$('.slider:last .accordion.closed li h3').closest('li').toggleClass('open');
	}
	$('.slider:last .accordion li h3').click(function(){
		$(this).nextAll().slideToggle('fast');
		if (!$(this).parents('li').hasClass('open'))
			$(this).closest('.accordion').find('.select_icon').addClass('hidden');
		else if ($(this).closest('.accordion').find('.selected').length)
			$(this).closest('.accordion').find('.select_icon').removeClass('hidden');
		$(this).parents('li').toggleClass('open');
	});
	$('.slider:last .button.load_cards').click(function () {
		var arrDataParams = {
			intSetCount : $('.slider:last input.sheets.required').val(),
