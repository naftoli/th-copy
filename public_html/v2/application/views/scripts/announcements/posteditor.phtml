					'content' : posteditor.getData(),
					'associate_students' : $('#new_announcements_students_input').val()
				};
				$.ajax({
					type : "POST",
					cache : false,
					url : '<?php print $sn . '/announcements/posteditor/setter/true/ajax/true' . $strParamPath; ?>',
					dataType : "text",
					data: arrParams,
					success : function(strResponse) {
						try {
							var arrData = jQuery.parseJSON(strResponse);
						} catch(e) {
							$.alert(strResponse);
							return;
						}
						if (typeof(arrData) != "object") {
							$.alert(arrData);
							return;
						} else if (arrData.success) {
							slideRefresh('<?php print $sn . '/announcements/posteditor/saved/true/announcement_id/'; ?>' + arrData.announcement_id);
						} else {
							$.alert(arrData);
							return;
						}
					}
				});
			});
			$('.slider:last .student_image_list img').hover(function (e) {
				var strTitle = $(this).attr('tip');
				if (!strTitle.length)
					return;
				var objPosition = $(this).position();
				var objDiv = $("<div class='tooltip_workaround' />")
					.css({
						'position' : 'absolute',
						'white-space' : 'nowrap',
						'top' : objPosition.top + 50,
						'left' : objPosition.left,
						'background-color' : '#fff',
						'border' : '1px solid black',
						'z-index' : 10000,
						'padding' : 6,
						'display' : 'none'
					})
					.html(strTitle);
				$('.slider:last').append(objDiv);
				$(objDiv).fadeIn();

			});
			$('.slider:last .student_image_list img').mouseout(function () {
				$('.slider:last .tooltip_workaround').stop().fadeOut().queue(function () {
					$(this).dequeue().remove();
				});
			});
			$('.slider:last #classes').change(function () {
				var arrParams = {
					'publish_to_classes' : $(this).val(),
					'announcement_id' : intAnnouncementId
				};
