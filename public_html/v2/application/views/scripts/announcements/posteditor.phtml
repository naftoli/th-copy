			$('.slider:last .submit').click(function () {
				var arrParams = {
					'remove_publish' : $(this).hasClass('remove_publish'),
					'publish' : $(this).hasClass('publish'),
					'delete' : $(this).hasClass('delete'),
					'draft' : $(this).hasClass('draft'),
