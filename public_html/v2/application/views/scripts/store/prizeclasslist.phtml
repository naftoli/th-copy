<?php
	include "config.phtml";
	include "parameters.phtml";
	$user_session_data = new Zend_Session_Namespace('user_session_data');
?>
<div class="slider">
	<div class="col_title">
		<span>Prizes by <?php echo ($user_session_data->institution_type == "School" ? "Classes" : "Bunks"); ?> </span>
