<script language="javascript">
$('#slider_gradesedit #editgrade a.submit').click( function(e)
{
	e.preventDefault();
	$('#editgrade').submit();
});
$(document).ready(function()
{

	$("#editgrade").validate({
		onsubmit: true,
		rules:
		{
			name: { required: true },
		},
		messages:
		{
			name: "Please enter grade name",
		},
		submitHandler: function(form) {
			$.ajax( {
				type : "POST",
				cache : false,
				start: $("#processing_status").html('loading...'),
				url : '<?php echo $sn; ?>/grades/gradesedit<?php echo $strUrl; ?>',
				dataType : "text",
				data: $('#editgrade').serialize(),
				success : function(response) {
					$("#processing_status").html(response);
				}
			});
		}
	});
});
</script>
<div class="slider" id='slider_gradesedit'>
	<div class="col_title">
