						<input type="hidden" name="institution_id" id="institution_id" value="<?php echo $this->arrGrade->institution_id; ?>" />
						<li>
							<span class="label">Grade Name:</span>
							<span class="input"><input type="text" name="name" id="name" value="<?=$this->arrGrade->grade_name?>" /></span>
							<div class="clear"></div>
						</li>
						<li>
							<span><a href="#" title="Save" class="button submit">Save</a></span>
							<div class="clear"></div>
						</li>
					</ul>
				</form>
			</div>
