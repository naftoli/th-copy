<script language="javascript">
function calculate_addon_fees()
{
	var intPrice = 0;
	var intTotalAmount = 0;
	var arrAddonPrices =  $('.addon_fee');	
	$("#grandtotalfees span").text(0);

	for (var intKey=0; intKey != arrAddonPrices.length; intKey++)
	{
		var arrInputs = $(arrAddonPrices[intKey]).children();        
		if($(arrInputs[0]).attr("checked"))
		{
			intPrice = parseFloat($(arrInputs[1]).val());			
			intTotalAmount += parseFloat($(arrInputs[1]).val());
		}
	}
	$("#grandtotalfees span").text(intTotalAmount);
	$("#grandtotalfees input").val(intTotalAmount);
}
$(function(){
	$('.addon_fee input:checkbox').change(function(){
		if ($(this).is(':checked')) {
			$(this).parent().addClass('checked');
		} else {
			$(this).parent().removeClass('checked');
		}
		calculate_addon_fees();
	}).change();
	$('.module_buttons .select_all').click(function(){
		$('.addons input:checkbox').attr('checked',true).change();
	});
	$('.module_buttons .select_none').click(function(){
		$('.addons input:checkbox').attr('checked',false).change();
	});
});
function form_submit()
{
	if(!$("#slider_store_front #cccardcheck").attr("checked"))
	{
		alert("You must accept charges that will be charged to your credit card!");
		return;
	}    
	$.ajax({
		type : "POST",
		cache : false,
		start: $("#slider_store_front #processing_status").html('Loading...').fadeIn("slow"),
		url : '<?php echo $sn; ?>/packages/storefront<?php print $strParamPath;?>',
		dataType : "text",
		data: $('"#slider_store_front #store_front').serialize(),
		success : function(response) {
			if (response.match(/^[0-9]+$/)) {
				$("#slider_store_front #processing_status").html("Your institution successfully signed up for add-on(s)").fadeIn("slow").delay(2000).fadeOut("slow");
				slideRefresh();
			} else {
				$("#slider_store_front #processing_status").html(response).fadeIn("slow");
			}
		}
	});
}

</script>
