<script language="javascript">
var checkbox_select_group_1 = false;

function toggleCheckboxes(group)
{
	if(group == "group_1")
	{
		field = document.packageclasses.class_id;
		if(checkbox_select_group_1)
		{
			checkbox_select_group_1 = false;
			selected_status = false;			
			$("#group_status").html("SELECT ALL");
			for (i = 0; i < field.length; i++)
			{
				field[i].checked = selected_status;				
			}
		}
        else
		{
			checkbox_select_group_1 = true;
			selected_status = true;
			$("#group_status").html("DESELECT ALL");
			for (i = 0; i < field.length; i++)
			{
				field[i].checked = selected_status;
			}
		}
	}
}
$(document).ready(function()
{
	$('#packageclasses a.submit').click( function(e) {
		e.preventDefault();
		$.ajax({
			type : "POST",
			cache : false,
			start: $("#processing_status").html('Loading...').fadeIn("slow"),
			url : '<?php echo $sn; ?>/packages/packagesclasses',
			dataType : "text",
			data: $('#packageclasses').serialize(),
			success : function(response) {
				if (response.match(/^[0-9]+$/)) {
					$("#processing_status").html("Save successful.").fadeIn("slow").delay(2000).fadeOut("slow");
                    slideRefresh();
				} else {
					$("#processing_status").html(response).fadeIn("slow");
				}
			}
		});
	});
});
function deleteClassAddon(addon_config_id)
{
		$.ajax({
			type : "POST",
			cache : false,
			start: $("#processing_status2").html('Loading...').fadeIn("slow"),            
			url : '<?php echo $sn; ?>/packages/packagesclasses/mode/delete/addon_config_id/'+addon_config_id,
			dataType : "text",
			data: $('#slider_packageclasses #existingaddonconfiguration').serialize(),
			success : function(response) {
				if (response.match(/^[0-9]+$/)) {
					$(" #processing_status2").html("Addon for this class was removed. It will no longer be available to students to purchase.").fadeIn("slow").delay(5000).fadeOut("slow");
                    slideRefresh();
				} else {
					$("#processing_status2").html(response).fadeIn("slow");
				}
			}
		});
}


