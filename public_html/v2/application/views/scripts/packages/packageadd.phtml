<script>
function calculate_fees()
{
	var intPrice = 0;
	
	var arrAddonPrices =  $('.addon_fee');	
	$("#price").val(0);
	for (var intKey=0; intKey != arrAddonPrices.length; intKey++)
	{
		var arrInputs = $(arrAddonPrices[intKey]).children();
		if($(arrInputs[0]).attr("checked"))
		{
			intPrice = parseFloat($(arrInputs[1]).val()) + parseFloat($("#price").val());
			$("#price").val(intPrice);
		}
	}
	$("#price").val(intPrice);
}

$(document).ready(function()
{
	$('#formaddpackage a.submit').click( function(e) {
		e.preventDefault();
		$.ajax({
			type : "POST",
			cache : false,
			start: $("#processing_status").html('Loading...').fadeIn("slow"),
			url : '<?php echo $sn; ?>/packages/packageadd/host_id/<?=$this->host_id?>/network_id/<?=$this->network_id?>',
			dataType : "text",
			data: $('#formaddpackage').serialize(),
			success : function(response) {
				if (response.match(/^[0-9]+$/)) {
					$("#processing_status").html("Save successful.").fadeIn("slow").delay(2000).fadeOut("slow");
				} else {
					$("#processing_status").html(response).fadeIn("slow");
				}
			}
		});
	});
});
</script>
