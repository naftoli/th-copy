	function proc_action(strAction, intRow)
	{
		var objPrevSlider = $(".slider:last").prev();
		var objTarget = objPrevSlider.find("#<?php print $this->strObjSrc; ?>");
		var objSourceInput = objTarget.find("input[type='hidden']");
		var strSourceData = objSourceInput.val();
		var arrResult = jQuery.parseJSON(strSourceData);
		if (strAction == "delete")
		{
			if (arrResult[intRow])
				arrResult.splice(intRow, 1);
		}
		else if (strAction == "up")
		{
			var objTemp = arrResult[intRow];
			if (intRow == 1)
			{
				if (arrResult[intRow])
					arrResult.splice(intRow, 1);
				arrResult.unshift(objTemp);
			}
			else
			{
				var arrTempResult = arrResult.slice(0,intRow-1);
				arrTempResult.push(objTemp);
				if (arrResult[intRow])
					arrResult.splice(intRow, 1);
				for (var intItr=intRow-1; intItr<arrResult.length; intItr++)
				{
					arrTempResult.push(arrResult[intItr]);
				}
				arrResult = arrTempResult;
			}
		}



		var strNewSerializedData = JSON.stringify(arrResult);
		objSourceInput.val(strNewSerializedData);
		objSourceInput.trigger('update');
		lists_gen();
		list_process();
		objTarget.find(".title").html(objTarget.find(".title").html().replace(/[0-9]+/, arrResult.length));
	}

	function list_process()
	{
		var arrCells = $(".slider:last form").serializeArray();
		var arrCellHash = [];
		var arrDataModel = jQuery.parseJSON(decodeURIComponent($(".slider:last #datamodel").val()));
		var objPrevSlider = $(".slider:last").prev();
		var objTarget = objPrevSlider.find("#<?php print $this->strObjSrc; ?>");
		var objSourceInput = objTarget.find("input[type='hidden']");
		var strSourceData = objSourceInput.val();
		var objContainer = $(".slider:last #list_container");
		for (var intItr in arrCells)
		{
			var arrParsedName = arrCells[intItr].name.split(/_/);
			if (!arrCellHash[arrParsedName[1]])
				arrCellHash[arrParsedName[1]] = [];
			arrCellHash[arrParsedName[1]][arrParsedName[2]] = arrCells[intItr];
		}
		var intRows = $(".slider:last .list_row").length;
		var arrResult = jQuery.parseJSON(strSourceData);
		for (var intItr=0; intItr!=intRows; intItr++)
		{
			// new item
			var arrTemp = arrResult[intItr] ? arrResult[intItr] : arrDataModel;
			var boolOmitNewRow = 1;
			for (var intItr2 in arrFields)
			{
				var strCellData = arrCellHash[intItr][intItr2];
				arrTemp[arrFields[intItr2].split(/:/)[0]] = strCellData.value;
				if (strCellData.value.length && arrFields[intItr2].split(/:/)[0] != strHierarchyCol)
					boolOmitNewRow = 0;
			}
			if (strHierarchyCol)
				arrTemp[strHierarchyCol] = intItr;
			if (!boolOmitNewRow)
				arrResult[intItr] = arrTemp;
		}
		//$.dumper(arrResult);
		// Send parsed data to source
		var strNewSerializedData = JSON.stringify(arrResult);
		objSourceInput.val(strNewSerializedData);
		objSourceInput.trigger('update');
		if (objContainer.find(".list_row:last input[type='text']:first").val().length)
		{
			lists_gen();
			objContainer.find(".list_row:last input[type='text']:first").focus();
			objTarget.find(".title").html(objTarget.find(".title").html().replace(/[0-9]+/, arrResult.length));
		}
	}
</script>
