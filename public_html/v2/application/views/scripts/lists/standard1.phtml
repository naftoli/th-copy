	function disablekeys(evt) {
		var charCode = (evt.which) ? evt.which : event.keyCode
		if (
			charCode != 9 // tab
			&& charCode != 13 // enter
			&& charCode != 16 // shift
			&& charCode != 38 // arrow
			&& charCode != 39 // shift
			&& charCode != 40 // shift
			&& charCode != 37 // shift
		)
			return false;
	}

	function cellkeypress(evt) {
		var charCode = (evt.which) ? evt.which : event.keyCode
		if (
			charCode == 9
			|| charCode == 13
		) {
			list_process();
			return false;
		}
	}

	function lists_gen() {
		// Load and validate source data
		var objPrevSlider = $(".slider:last").prev();
		var objTarget = $(objPrevSlider).find("#<?php print $this->strObjSrc; ?>");
		var objContainer = $(".slider:last #list_container");
		if (!objTarget.length)
		{
			objContainer.html("<?php print text("Sorry, there was an error"); ?>: VL-S101-A9D9SA");
