				json_response(strResponse, {
					success : function () {

					},
					fail : function () {

					}
				});
			}
		});
	});
	// close settings
	$(".slider:last .close_settings").click(function () {
		$(".slider:last .page_settings li").hide();
		$(this).hide();
		$(".slider:last .page_settings_btn").fadeIn();
		$(".slider:last .date_display").removeClass("edit_mode");
		$(".slider:last .date_editor").addClass("hidden");
		$.ajax({
			type : "POST",
			cache : false,
			url : $("#pointsgridclasstasks").data("url"),
			dataType : "text",
			data: {
				"classtasksettings" : 0
			},
			success : function(strResponse) {
				json_response(strResponse, {
					success : function () {

					},
					fail : function () {

					}
				});
			}
		});
	});
	// config task order menu click
	$(".slider:last .task_order").click(function () {
		if ($(this).hasClass("selected"))
		{
			$(this).removeClass("selected");
			$(".slider:last .column_order_row").addClass("hidden");
		} else {
			$(this).addClass("selected");
			$(".slider:last .column_order_row").removeClass("hidden");
			var arrOrderCells = $.makeArray($(".slider:last .column_order:not(.hidden)"));
			for (var intItr = 0; intItr != arrOrderCells.length; intItr++)
			{
				$(arrOrderCells[intItr]).find("input").val(intItr+1)
			}
			$(arrOrderCells[0]).find("input").focus();
		}
	});
	$(".slider:last #checklist_campaigntasks").click(function () {
		$(".slider:last .task_order").removeClass("selected");
		$(".slider:last .column_order_row").addClass("hidden");
	});
	$(".slider:last .noinput").focus(function () {
		if ($(this).hasClass('noinput')) {
			$(this).html('').removeClass('noinput');
		}
	});

<?php
