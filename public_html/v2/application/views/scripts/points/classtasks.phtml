						},
						fail : function () {

						}
					});
				}
			});
			//$(".slider:last").trigger("update_cols");
		}
		else if ($(".slider:last").data("classes") != $("#pointsgridclasstasks #classes").val())
		{
			$.ajax({
				type : "POST",
				cache : false,
				url : $("#pointsgridclasstasks").data("url"),
				dataType : "text",
				data: {
					"classes" : $("#pointsgridclasstasks #classes").val()
				},
				success : function(strResponse) {
					json_response(strResponse, {
						success : function () {
							$(".slider:last").trigger("ajax_grid_refresh");
						},
						fail : function () {

						}
					});
				}
			});
		}
	});
	// gird refresh
	$(".slider:last").bind("ajax_grid_refresh", function () {
		$.ajax({
			type : "GET",
			cache : false,
			url : $("#pointsgridclasstasks").data("url") + '/boolAjax/true',
			dataType : "text",
			success : function(strResponse) {
				$(".slider:last .task_order").removeClass("selected");
				$(".slider:last .ajax_grid_module").html(strResponse);
				$(".slider:last").trigger("update_cols");
			}
		});
	});
	$(".slider:last").data("campaign_tasks", "<?php print @$this->arrConfig["admin"]["pointsclass" . $this->taskType . "tasks"]; ?>");
	$(".slider:last").data("classes", "<?php print @$this->arrConfig["admin"]["classtasksclasses"]; ?>");
	// process the grid objects
	$(".slider:last").bind("update_cols", function () {
		var strTasks = $(".slider:last").data("campaign_tasks");
		var arrTasks = strTasks.split(/&/);
		var arrTaskHash = {};
		for (var intItr in arrTasks)
		{
			arrTaskHash[arrTasks[intItr].split(/=/)[0]] = 1;
		}
		/*
		// hide hidden tasks
		var arrPods = ["header_task", "column_order", "fill_task", "row_task"];
		for (var intItr2 in arrPods)
		{
			var arrTaskNames = $.makeArray($(this).find("." + arrPods[intItr2]));
			for (var intItr in arrTaskNames)
			{
				var intTask = $(arrTaskNames[intItr]).attr("id").split(/_/)[2];
				if (!arrTaskHash[intTask])
				{
					$(arrTaskNames[intItr]).addClass("hidden");
					$(arrTaskNames[intItr]).find("input").val("");
				}
				else
				{
					$(arrTaskNames[intItr]).removeClass("hidden");
				}
			}
		}
		*/
		// row input keyup
		$(this).find(".row_task input").unbind("contextmenu").bind("contextmenu", function (e) {
			if ($(this).val()*1 == 0) {
				$(this).val($(this).attr('points'));
				return false;
			}
		});
		$(this).find(".row_task input").unbind("keyup").bind("keyup", function () {
			if ($(this).val().match(/[^0-9]+/))
				$(this).val($(this).val().replace(/[^0-9]+/, ""));
			if ($(this).val()!=""&&$(this).val()*1!==$(this).val())
				$(this).val($(this).val()*1);
			$(this).css({
				color: 'black'
			});
			if ($(this).val() != 0) {
				if ($(this).attr('min_points') != 0 && $(this).val()*1 < $(this).attr('min_points')) {
					$(this).css({
						color: 'red'
					});
				}
				if ($(this).attr('max_points') != 0 && $(this).val()*1 > $(this).attr('max_points')) {
					$(this).css({
						color: 'red'
					});
				}
			}
		});
		// fill blur
		$(this).find(".row_task input").unbind("helper").bind('helper', function (e,strMessage) {
			var objPos = $(this).position();
			$('#point_grid_message').remove();
			var objMessage = $("<div id='point_grid_message'></div>");
			objMessage.css({
				left: objPos.left + $(this).width(),
				top: objPos.top + $(this).height(),
				'background-color' : '#fff',
				color : 'red',
				padding : '3px 7px',
				border : '1px solid red',
				position : 'absolute',
				'font-size' : '14pt'
			});
			objMessage.html(strMessage);
			$(this).after(objMessage);
			objMessage.delay(3000).queue(function () {
				$(this).dequeue().fadeOut();
			});
		});
		$(this).find(".row_task input").unbind("blur").bind("blur", function () {
			if ($(this).val()*1!==$(this).val())
				$(this).val($(this).val()*1);
			if ($(this).val() != 0) {
				if ($(this).attr('min_points') != 0 && $(this).val() < $(this).attr('min_points') * 1) {
					$(this).val($(this).attr('orgvalue'));
					$(this).trigger('helper', 'Point range accepted ' + $(this).attr('min_points') + ' - ' + $(this).attr('max_points'));
				}
				if ($(this).attr('max_points') != 0 && $(this).val() > $(this).attr('max_points') * 1) {
					$(this).val($(this).attr('orgvalue'));
					$(this).trigger('helper', 'Point range accepted ' + $(this).attr('min_points') + ' - ' + $(this).attr('max_points'));
				}
			}
		});
		// fill focus
		$(this).find(".row_task input").unbind("click").bind("click", function () {
			$(this).css({
				color: '#000'
			});
			if ($(this).val() == 0) {
				$(this).select();
			}
		});
		$(this).find(".fill_task input").unbind("focus").bind("focus", function () {
			var intTask = $(this).attr("name");
			$(this).data("start_data", $.makeArray($(".slider:last").find(".row_task_" + intTask + " input").clone()));
		});
		// fill keyup
		$(this).find(".fill_task input").unbind("keyup").bind("keyup", function () {
			if ($(this).val().match(/[^0-9]+/))
				$(this).val($(this).val().replace(/[^0-9]+/, ""));
			if ($(this).val()!=""&&$(this).val()*1!==$(this).val())
				$(this).val($(this).val()*1);
			var intTask = $(this).attr("name");
			if ($(this).val() == "")
			{
				var arrStartData = $(this).data("start_data");
				var arrInputs = $.makeArray($(".slider:last").find(".row_task_" + intTask + " input"));
				for (var intItr = 0; intItr != arrStartData.length; intItr++)
				{
					$(arrInputs[intItr]).val($(arrStartData[intItr]).val());
				}
			}
			else
				$(".slider:last").find(".row_task_" + intTask + " input").val($(this).val());
		});
		// fill blur
		$(this).find(".fill_task input").unbind("blur").bind("blur", function () {
			$(this).val("");
		});
		// custimize task order focus
		$(this).find(".column_order input").focus(function () {
			if ($(".slider:last").data("refReOrderTimeout"))
				window.clearTimeout($(".slider:last").data("refReOrderTimeout"));
		});
		// custimize task order blur
		$(this).find(".column_order input").unbind("blur").blur(function () {
			// save on blur timeout
			$(".slider:last").data("refReOrderTimeout", window.setTimeout(function () {
				var arrValues = {};
				var arrOrderCells = $.makeArray($(".slider:last").find(".column_order:not(.hidden) input"));
				for (var intItr = 0; intItr != arrOrderCells.length; intItr++)
				{
					arrValues[$(arrOrderCells[intItr]).attr("name")] = $(arrOrderCells[intItr]).val();
				}
				$.ajax({
					type : "POST",
					cache : false,
					url : $("#pointsgridclasstasks").data("url"),
					dataType : "text",
					data: {
						"classtaskcolumnorder" : serialize(arrValues)
					},
					success : function(strResponse) {
						json_response(strResponse, {
							success : function () {
								$(".slider:last .task_order").removeClass("selected");
								$(".slider:last").trigger("ajax_grid_refresh");
							},
							fail : function () {

							}
						});
					}
				});
			}, 800));
			var arrOrderCells = $.makeArray($(".slider:last").find(".column_order:not(.hidden) input"));
			//$.alert(arrValues);
			// find the first missing iteration
			for (var intFirstMissing=1; intFirstMissing!=arrOrderCells.length; intFirstMissing++)
			{
				var boolFound = 0;
				for (var intItr=0; intItr!=arrOrderCells.length; intItr++)
				{
					if ($(arrOrderCells[intItr]).val() == intFirstMissing)
					{
						boolFound = 1;
						break;
					}
				}
				if (!boolFound)
					break;
			}
			for (var intItr=0; intItr!=arrOrderCells.length; intItr++)
			{
				if (
					$(this).attr("name") != $(arrOrderCells[intItr]).attr("name")
					&& $(this).val() == $(arrOrderCells[intItr]).val()
				)
					$(arrOrderCells[intItr]).val(intFirstMissing);
			}
		});
		/////
		$('.slider:last .is_checkbox_button').bind('update', function () {
			if (!$(this).parent().find('input').hasClass('checked')) {
				$(this).parent().find('input').val($(this).parent().find('input').attr('offvalue'));
				$(this).stop().animate({
					'opacity' : 0.3,
					'background-color' : '#EEEEEE'
				});
			} else {
				$(this).parent().find('input').val($(this).parent().find('input').attr('onvalue'));
				$(this).stop().animate({
					'opacity' : 1,
					'background-color' : '#fff'
				});
			}
		});

		$('.slider:last .is_checkbox_button').click(function () {
			if ($(this).parent().find('input').hasClass('checked')) {
				$(this).parent().find('input').removeClass('checked');
			} else {
				$(this).parent().find('input').addClass('checked');
			}
			$(this).trigger('update');
		});
		$('.slider:last .is_checkbox_button').trigger('update');
		$('.slider:last .fill_task .is_checkbox_button').bind('update', function () {
			var objInput = $(this).parent().find('input');
			var allInputs = $('.row_task_'+objInput.attr('task_id')+' .is_checkbox_input');
			if (objInput.hasClass('checked')) {
				allInputs.addClass('checked');
			} else {
				allInputs.removeClass('checked');
			}
			$('.row_task_'+objInput.attr('task_id')+' .is_checkbox_button').trigger('update');
		});
		$('.slider:last .fill_task .is_checkbox_button').bind('mouseover', function () {
			$(this).stop().animate({
				'opacity' : $(this).parent().find('input').hasClass('checked') ? 1 : 0.3,
				'background-color' : '#fff'
			});
		});
		$('.slider:last .fill_task .is_checkbox_button').bind('mouseout', function () {

			$(this).stop().animate({
				'opacity' : 0,
				'background-color' : '#EEEEEE'
			});
		});
		$('.slider:last .fill_task .is_checkbox_button').stop().css({
			opacity : 0
		});
	});
