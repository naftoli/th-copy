				}
				else
				{
					$(".slider:last #processing_status").html("<?php print text("Sorry, there was an error"); ?>: VP-CT103-f3f2ff");
					$.alert(strResponse);
					return;
				}
			}
		});
	});
	// grid options slide back
	$(".slider:last").bind("slide_back", function () {
		if ($(".slider:last").data("campaign_tasks") != $("#pointsgridclasstasks #campaign_tasks").val())
