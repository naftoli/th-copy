	// date picker change
	$(".slider:last .date_editor input.datepicker").change(function () {
		if ($(this).val() == "<?php print date('m') . "/" . date("d") . "/" . date("Y"); ?>")
			$(".slider:last .date_text").html("Today");
		else if ($(this).val() == "<?php print date('m',strtotime("-1 day")) . "/" . date("d",strtotime("-1 day")) . "/" . date("Y",strtotime("-1 day")); ?>")
			$(".slider:last .date_text").html("Yesterday");
		else
			$(".slider:last .date_text").html($(this).val());
			
		// change date on link for choosing campaigns
		var dateInfo = $(this).val();
		var date = new Date(dateInfo);
		var unixdate = date.getTime() / 1000;
		var href = $(".slider:last #checklist_campaigntasks a").attr('href');
		var pos = href.lastIndexOf('/');
		href = href.substring(0,++pos);
		href += unixdate;
		$(".slider:last #checklist_campaigntasks a").attr('href', href);
		
		// modify the base path url to hold date info
		var strUrl = $(".slider:last").data("url");
		strUrl = strUrl.replace(/\/class_tasks_date\/[^\/]+/, "");
		strUrl += "/class_tasks_date/" + encodeURIComponent(encodeURIComponent($(this).val()));
		$(".slider:last").data("url", strUrl).trigger("ajax_grid_refresh");
	});
	// sm change
	$(".slider:last #sm").change(function () {
		// modify the base path url to hold date info
		var strUrl = $(".slider:last").data("url");
		strUrl = strUrl.replace(/\/class_tasks_date\/[^\/]+/, "");
		strUrl += "/class_tasks_date/" + encodeURIComponent(encodeURIComponent($(this).val()));
		$(".slider:last").data("url", strUrl).trigger("ajax_grid_refresh");
	});
	// open settings
	$(".slider:last .page_settings_btn").click(function () {
		$(".slider:last .page_settings li").fadeIn();
		$(this).closest("li").hide();
		$(".slider:last .close_settings").fadeIn();
