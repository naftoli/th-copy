					$(".slider:last #processing_status").html("<?php print text("Sorry, there was an error"); ?>: VP-CT101-as654d");
					$.alert(strResponse);
					return;
				}
				if (typeof(arrResponse) != "object") {
					$(".slider:last #processing_status").html("<?php print text("Sorry, there was an error"); ?>: VP-CT102-54h5hg");
					$.alert(strResponse);
					return;
				}
				else if (arrResponse["success"] == "true")
				{
					$(".slider:last #processing_status").html("<?php print text("Saved"); ?>").fadeOut("slow");
