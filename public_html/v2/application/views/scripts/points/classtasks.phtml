			$.ajax({
				type : "POST",
				cache : false,
				url : $("#pointsgridclasstasks").data("url"),
				dataType : "text",
				data: {
					"campaign_tasks" : $("#pointsgridclasstasks #campaign_tasks").val()
				},
				success : function(strResponse) {
					json_response(strResponse, {
						success : function () {
