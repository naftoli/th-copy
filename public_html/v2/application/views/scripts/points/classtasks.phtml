		<?php else : ?>
		d = $("input.datepicker").val();
		<?php endif; ?>
		$.ajax({
			type : "POST",
			cache : false,
			start : $(".slider:last #processing_status").html('Loading...').fadeIn("fast"),
			url : $("#pointsgridclasstasks").data("url"),
			data : {
				'strDescription' : $('#pointsgridclasstasks .text_description').val(),
