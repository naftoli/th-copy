<? $admin_auth = array(); ?>
<? require('header.php'); ?>
<?
require_once('file_save.php');
$action = gr('action');
$edit_row = false;

if(!empty($action)) switch($action) {
  case 'add':
    $result = mq("SELECT -1 subject_id, '' subject_name, -1 inst_id, '' subject_type, NULL subject_image_id");
    $edit_row = mysql_fetch_assoc($result);
    $school_type_ids = array();
    break;

  case 'add2':
    $subject_name = gr('subject_name');
    $inst_id = gri('inst_id', -1);
    $subject_type = gr('subject_type');
    $school_type_ids = gra('school_type_ids', array());

    $result = mq('SELECT 1 FROM subjects WHERE subject_name = ' . ms($subject_name) . " AND inst_id = $inst_id");

    if(mysql_num_rows($result)) {
      $message = T_('Unable to add new subject, this name/institution type pair is already used.');
      $result = mq('SELECT -1 subject_id, ' . ms($subject_name) . " subject_name, $inst_id inst_id, " . ms($subject_type) . ' subject_type, NULL subject_image_id');
      $edit_row = mysql_fetch_assoc($result);
      $action = 'add';
    } else {
      $subject_image_id = 'NULL';
      if(isset($_FILES['image'])) $subject_image_id = addFile($_FILES['image'], $subject_image_id);
      mq('INSERT INTO subjects (subject_name, inst_id, subject_type, subject_image_id) VALUES (' . ms($subject_name) . ", $inst_id, " . ms($subject_type) . ", $subject_image_id)");
      $subject_id = mysql_insert_id();
      foreach($school_type_ids as $school_type_id) {
        mq("INSERT INTO school_type_subjects (subject_id, school_type_id) VALUE ($subject_id, $school_type_id)");
      }

      $message = T_('Subject added');
    }
    break;

  case 'delete':
    mq('DELETE FROM files USING files JOIN subjects ON (files.file_id = subjects.subject_image_id) WHERE subject_id = ' . gri('subject_id', -1));
    mq('DELETE FROM subjects WHERE subject_id = ' . gri('subject_id', -1));
    mq('DELETE FROM school_type_subjects WHERE subject_id = ' . gri('subject_id', -1));
    mq('DELETE FROM user_tracks WHERE subject_id = ' . gri('subject_id', -1));
    mq('DELETE FROM files USING files JOIN medals_subjects ON (files.file_id = medals_subjects.medal_on_image_id) WHERE subject_id = ' . gri('subject_id', -1));
    mq('DELETE FROM files USING files JOIN medals_subjects ON (files.file_id = medals_subjects.medal_off_image_id) WHERE subject_id = ' . gri('subject_id', -1));
    mq('DELETE FROM files USING files JOIN medals_subjects ON (files.file_id = medals_subjects.medal_photo_id) WHERE subject_id = ' . gri('subject_id', -1));
    mq('DELETE FROM medals_subjects WHERE subject_id = ' . gri('subject_id', -1));
    $message = T_('Subject deleted');
    break;

  case 'edit':
    $subject_id = gri('subject_id', -1);
    $result = mq("SELECT school_type_id FROM school_type_subjects WHERE subject_id = $subject_id");
    $school_type_ids = mysql_fetch_column($result);
    $result = mq("SELECT subject_id, subject_name, inst_id, subject_type, subject_image_id FROM subjects WHERE subject_id = $subject_id");
    $edit_row = mysql_fetch_assoc($result);
    $medals = mq("SELECT medals.medal_ord, medal_name, missions_required, medals_subjects.medal_on_image_id, medals_subjects.medal_off_image_id, medals_subjects.medal_photo_id, medals_subjects.profile_photo_id FROM medals LEFT JOIN medals_subjects ON (medals.medal_ord = medals_subjects.medal_ord AND subject_id = $subject_id) ORDER BY medal_ord");
    break;

  case 'edit2':
    $subject_name = gr('subject_name');
    $inst_id = gri('inst_id', -1);
    $subject_type = gr('subject_type');
    $subject_id = gri('subject_id', -1);
    $school_type_ids = array_filter(gra('school_type_ids', array()), 'is_numeric');

    $result = mq('SELECT 1 FROM subjects WHERE subject_name = ' . ms($subject_name) . " AND inst_id = $inst_id AND subject_id != $subject_id");

    if(mysql_num_rows($result)) {
      $message = T_('Unable to edit subject, this name/institution type pair is already used.');
      $result = mq("SELECT $subject_id subject_id, " . ms($subject_name) . " subject_name, $inst_id inst_id, " . ms($subject_type) . " subject_type, subject_image_id FROM subjects WHERE subject_id = $subject_id");
      $medals = mq("SELECT medals.medal_ord, medal_name, missions_required, medals_subjects.medal_on_image_id, medals_subjects.medal_off_image_id, medals_subjects.medal_photo_id, medals_subjects.profile_photo_id FROM medals LEFT JOIN medals_subjects ON (medals.medal_ord = medals_subjects.medal_ord AND subject_id = $subject_id) ORDER BY medal_ord");
      $edit_row = mysql_fetch_assoc($result);
      $action = 'edit';
    } else {
      $subject_image_id = gri('image_delete', 0) ? 'NULL' : 'subject_image_id';
      if(isset($_FILES['image'])) $subject_image_id = addFile($_FILES['image'], $subject_image_id);

      if($subject_image_id !== 'subject_image_id') mq("DELETE FROM files USING files JOIN subjects ON (files.file_id = subjects.subject_image_id) WHERE subject_id = $subject_id");

      mq('UPDATE subjects SET subject_name = ' . ms($subject_name) . ', subject_type = ' . ms($subject_type) . ", subject_image_id = $subject_image_id WHERE subject_id = $subject_id");
      mq("DELETE FROM school_type_subjects WHERE subject_id = $subject_id AND school_type_id NOT IN (" . implode(',', array_merge(array(-1), $school_type_ids)) . ")");
      foreach($school_type_ids as $school_type_id) {
        mq("INSERT IGNORE INTO school_type_subjects (subject_id, school_type_id) VALUE ($subject_id, $school_type_id)");
      }

      foreach(gra('medals') as $medal_ord => $data) {
        $medal_ord = intval($medal_ord);

        if($data['missions_required'] === '') {
          mq("DELETE FROM files USING files JOIN medals_subjects ON (files.file_id = medals_subjects.medal_on_image_id) WHERE subject_id = $subject_id AND medal_ord = $medal_ord");
          mq("DELETE FROM files USING files JOIN medals_subjects ON (files.file_id = medals_subjects.medal_off_image_id) WHERE  subject_id = $subject_id AND medal_ord = $medal_ord");
          mq("DELETE FROM files USING files JOIN medals_subjects ON (files.file_id = medals_subjects.medal_photo_id) WHERE  subject_id = $subject_id AND medal_ord = $medal_ord");
          mq("DELETE FROM files USING files JOIN medals_subjects ON (files.file_id = medals_subjects.profile_photo_id) WHERE  subject_id = $subject_id AND medal_ord = $medal_ord");
          mq("DELETE FROM medals_subjects WHERE subject_id = $subject_id AND medal_ord = $medal_ord");
        } else {
          $data['missions_required'] = floatval($data['missions_required']);

          $image_on_id = isset($data['image_on_delete']) ? 'NULL' : 'medal_on_image_id';
          if(isset($_FILES["image_on_$medal_ord"])) $image_on_id = addFile($_FILES["image_on_$medal_ord"], $image_on_id);

          if($image_on_id !== 'medal_on_image_id') mq("DELETE FROM files USING files JOIN medals_subjects ON (files.file_id = medals_subjects.medal_on_image_id) WHERE subject_id = $subject_id AND medal_ord = $medal_ord");

          $image_off_id = isset($data['image_off_delete']) ? 'NULL' : 'medal_off_image_id';
          if(isset($_FILES["image_off_$medal_ord"])) $image_off_id = addFile($_FILES["image_off_$medal_ord"], $image_off_id);

          if($image_off_id !== 'medal_off_image_id') mq("DELETE FROM files USING files JOIN medals_subjects ON (files.file_id = medals_subjects.medal_off_image_id) WHERE subject_id = $subject_id AND medal_ord = $medal_ord");

          $photo_id = isset($data['photo_delete']) ? 'NULL' : 'medal_photo_id';
          if(isset($_FILES["photo_$medal_ord"])) $photo_id = addFile($_FILES["photo_$medal_ord"], $photo_id);

          if($photo_id !== 'medal_photo_id') 
            mq("DELETE FROM files USING files JOIN medals_subjects ON (files.file_id = medals_subjects.medal_photo_id) WHERE subject_id = $subject_id AND medal_ord = $medal_ord");

          $prf_photo_id = isset($data['prf_photo_delete']) ? 'NULL' : 'profile_photo_id';
          if(isset($_FILES["prf_photo_$medal_ord"])) $prf_photo_id = addFile($_FILES["prf_photo_$medal_ord"], $prf_photo_id);

          if($prf_photo_id !== 'profile_photo_id') 
            mq("DELETE FROM files USING files JOIN medals_subjects ON (files.file_id = medals_subjects.profile_photo_id) WHERE subject_id = $subject_id AND medal_ord = $medal_ord");

          mq("INSERT INTO medals_subjects SET subject_id = $subject_id, medal_ord = $medal_ord, medal_on_image_id = $image_on_id, medal_off_image_id = $image_off_id, medal_photo_id = $photo_id, profile_photo_id = $prf_photo_id, missions_required = {$data['missions_required']} ON DUPLICATE KEY UPDATE medal_on_image_id = $image_on_id, medal_off_image_id = $image_off_id, medal_photo_id = $photo_id, profile_photo_id = $prf_photo_id, missions_required = {$data['missions_required']}");
        }


      }

      $message = T_('Subject edited');
    }
    break;

  default:
    user_error('unknown action', E_USER_ERROR);
    break;
}

$school_type_result = mq('SELECT school_type_id, school_type_name FROM school_types ORDER BY school_type_name');
$institution_result = mq('SELECT inst_id, inst_name FROM institutions ORDER BY inst_name');
?>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01//EN"
   "http://www.w3.org/TR/html4/strict.dtd">
<HTML DIR="<?=$dir?>">
<HEAD>
<TITLE><?=T_('Subjects'), ' - ', T_('Tzivos Hashem Management System')?></TITLE>
<LINK href="admin_styles.css" rel="stylesheet" type="text/css">
</HEAD>
<BODY>
<?include('admin_header.php');?>
<DIV CLASS="body">
<H1><?=T_('Subjects')?></H1>
<?if(!empty($message)):?><H2><?=$message?></H2><?endif;?>
<?if($edit_row):?>

<FORM action="admin_subject.php" method="post" accept-charset="UTF-8" enctype="multipart/form-data">
<P>
<INPUT type="hidden" name="action" value="<?=$action?>2">
<INPUT type="hidden" name="subject_id" value="<?=$edit_row['subject_id']?>">
<LABEL><?=T_('Name')?><BR><INPUT type="text" name="subject_name" maxlength=255 value="<?=es($edit_row['subject_name'])?>"></LABEL><BR>
<LABEL><?=T_('Institution type')?><BR><SELECT name="inst_id">
      <? while($row = mysql_fetch_assoc($institution_result)): ?>
        <OPTION VALUE="<?=$row['inst_id']?>" <?=$row['inst_id'] == $edit_row['inst_id'] ? 'SELECTED' : '' ?>><?=es($row['inst_name'])?></OPTION>
      <? endwhile; ?>
</SELECT></LABEL><BR>
<LABEL><?=T_('Type')?><BR><SELECT name="subject_type">
      <? foreach(mysql_enum_values('subjects','subject_type') as $type): ?>
        <OPTION VALUE="<?=$type?>" <?=$edit_row['subject_type'] == $type ? 'SELECTED' : '' ?>><?=$type == 'goal_hist' ? T_('Show goals and history') : $type ?></OPTION>
      <? endforeach; ?>
</SELECT></LABEL><BR>
<LABEL><?=T_('Tzivos Hashem Types')?><BR><SELECT name="school_type_ids[]" multiple size="10">
      <? while($row = mysql_fetch_assoc($school_type_result)): ?>
        <OPTION VALUE="<?=$row['school_type_id']?>" <?=in_array($row['school_type_id'], $school_type_ids) ? 'SELECTED' : '' ?>><?=es($row['school_type_name'])?></OPTION>
      <? endwhile; ?>
</SELECT></LABEL><BR>
<LABEL><?=T_('Image')?><BR><INPUT type="file" name="image" class="file"></LABEL> <?=T_('Maximum file size')?>: <?=bytes2units(maxFileSize())?>B<BR>
<?if(!is_null($edit_row['subject_image_id'])):?>
<?=T_('Uploading a new image will replace the old.')?><BR>
<LABEL><?=T_('Delete current image')?> <INPUT type="checkbox" name="image_delete" class="checkbox" value="1"><BR>
<?=linkImgFile($edit_row['subject_image_id'])?><BR>
</LABEL>
<?endif?>
</P>

<?if(isset($medals)):?>
<TABLE class="pretty_grid">
<CAPTION><?=T_('Medals')?></CAPTION>
<TR>
  <TH rowspan="2"><?=T_('Medal')?></TH>
  <TH rowspan="2"><?=T_('Mission Requirements')?></TH>
  <TH><?=T_('Image On')?></TH>
  <TH rowspan="2"><?=T_('Medal Photo')?></TH>
  <TH rowspan="2"><?=T_('Medal Photo for Profile')?></TH>
</TR>
<TR>
  <TH><?=T_('Image Off')?></TH>
</TR>
<TR>
  <TH colspan=2><?=T_("Mission Requirements is required, if it's blank the medal does not exist for this subject. If zero it means the medal is automatically awarded.")?></TH>
  <TH colspan=2><?=T_('Maximum individual file size')?>: <?=bytes2units(maxFileSize())?><BR><?=T_('Maximum total combined file size')?>: <?=bytes2units(units2bytes(ini_get('post_max_size')))?></TH>
</TR>
<? while($row = mysql_fetch_assoc($medals)): ?>
<TR>
  <TD rowspan="2"><?=T_($row['medal_name'])?></TD>
  <TD rowspan="2"><INPUT type="text" name="medals[<?=$row['medal_ord']?>][missions_required]" maxlength="8" size="8" value="<?=es($row['missions_required'])?>" onChange="if(this.value != '') this.value = Math.max(0, Math.min(parseFloat('0'+this.value, 10), 999999.9)).toFixed(1);"></TD>
  <TD>
    <LABEL><?=T_('Image On')?><BR><INPUT type="file" name="image_on_<?=$row['medal_ord']?>" class="file"></LABEL><BR>
    <?if(!is_null($row['medal_on_image_id'])):?>
    <?=T_('Uploading a new image will replace the old.')?><BR>
    <LABEL><?=T_('Delete current image')?> <INPUT type="checkbox" name="medals[<?=$row['medal_ord']?>][image_on_delete]" class="checkbox" value="1"><BR>
    <?=linkImgFile($row['medal_on_image_id'], 350)?><BR>
    </LABEL>
    <?endif?>
  </TD>
  <TD rowspan="2">
    <LABEL><?=T_('Medal Photo')?><BR><INPUT type="file" name="photo_<?=$row['medal_ord']?>" class="file"></LABEL><BR>
    <?if(!is_null($row['medal_photo_id'])):?>
    <?=T_('Uploading a new image will replace the old.')?><BR>
    <LABEL><?=T_('Delete current image')?> <INPUT type="checkbox" name="medals[<?=$row['medal_ord']?>][photo_delete]" class="checkbox" value="1"><BR>
    <?=linkImgFile($row['medal_photo_id'], 350)?><BR>
    </LABEL>
    <?endif?>
  </TD>
  <TD rowspan="2">
    <LABEL><?=T_('Medal Photo for Profile')?><BR><INPUT type="file" name="prf_photo_<?=$row['medal_ord']?>" class="file"></LABEL><BR>
    <?if(!is_null($row['profile_photo_id'])):?>
    <?=T_('Uploading a new image will replace the old.')?><BR>
    <LABEL><?=T_('Delete current image')?> <INPUT type="checkbox" name="medals[<?=$row['medal_ord']?>][prf_photo_delete]" class="checkbox" value="1"><BR>
    <?=linkImgFile($row['profile_photo_id'], 100)?><BR>
    </LABEL>
    <?endif?>
  </TD>
</TR>
<TR>
  <TD>
    <LABEL><?=T_('Image Off')?><BR><INPUT type="file" name="image_off_<?=$row['medal_ord']?>" class="file"></LABEL><BR>
    <?if(!is_null($row['medal_off_image_id'])):?>
    <?=T_('Uploading a new image will replace the old.')?><BR>
    <LABEL><?=T_('Delete current image')?> <INPUT type="checkbox" name="medals[<?=$row['medal_ord']?>][image_off_delete]" class="checkbox" value="1"><BR>
    <?=linkImgFile($row['medal_off_image_id'], 350)?><BR>
    </LABEL>
    <?endif?>
  </TD>
</TR>
<? endwhile; ?>
</TABLE>
<?else:?>
<P><?=T_('Once you add the subject, please go back and edit it to add information about the medals.')?></P>
<?endif;?>
<P>
<INPUT type="submit" value="<?=$action=='edit' ? T_('Save') : T_('Add new')?>">
</P>
</FORM>

<A HREF="admin_subject.php"><?=T_('Cancel')?></A>
<?else:?>

<?$result = mq('SELECT subjects.subject_id, subjects.subject_name, subjects.subject_type, institutions.inst_name FROM subjects LEFT JOIN institutions USING (inst_id) ORDER BY institutions.inst_name, subjects.subject_name');?>

