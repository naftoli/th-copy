	<script>
		var group_types = "";
		
		$(document).ready(function() {				
			var camp_id = "<?=$camp_id;?>";
			
			action = "get_all_group_types_divisions_groups";				
			params = [camp_id];
			var url = "../application/php/appInterface.php?action=" + action + "&params=" + params;
			$.getJSON(url, function(data) {
				group_types = data;
				get_selects("group_type_id", 0, false);					
			});			
			
		});
		
		function set_date()
		{
			var currentTime = new Date()
			var month = currentTime.getMonth() + 1
			var day = currentTime.getDate()
			var year = currentTime.getFullYear()
			document.cms_presentation.adate.value=(month + "/" + day + "/" + year)

//var mycity = document.getElementById("acity");
	
		}

