<?=!is_null($user_row['school_logo_kiosk_id']) ? linkImgFile($user_row['school_logo_kiosk_id']) : (!is_null($user_row['school_logo_id']) ? linkImgFile($user_row['school_logo_id']) : '')?>
<P>
    <?=T_('Base')?>: #<?=$user_row['school_number']?><BR>
    <?=es($user_row['school_name'])?><BR>
    <?=es($user_row['rank_name'])?> <?=es($user_row['first'])?> <?=es($user_row['last'])?> <!--(<?=es($user_row['username'])?>)--> <?=es($user_row['first_he'])?> <?=es($user_row['last_he'])?>
</P>
<BR style="clear: both;">
</DIV>
<DIV id="body" class="body_<?=$align_start;?>">
<DIV id="page_title">
Welcome
</DIV>
<UL id="buttons">
  <LI><A HREF="deposit.php"><IMG src="images/icon_deposit.png" alt="" width="48" height="48"><?=T_('Deposit')?></A>
  <? $inbox = mysql_fetch_assoc(mq("SELECT COUNT(*) num FROM user_codes WHERE user_id = {$user_row['user_id']}")); ?>
  <? if($inbox['num']): ?>
  <DIV class="deposit_circle"><?=$inbox['num']?></DIV>
  <? endif; ?>
  <LI><A HREF="logout.php?n=statement.php"><?=T_('Logout')?></A>
</UL>
<TABLE>
<TR>
<TD class="photo"><?=!is_null($user_row['user_photo_id']) ? linkImgFile($user_row['user_photo_id']) : ''?><?=!is_null($user_row['rank_image_id']) ? linkImgFile($user_row['rank_image_id'], NULL, NULL, 'class="rank"') : ''?></TD>
<TD class="member_info">
    <H3><?=es($user_row['first_he'] ? $user_row['first_he'] : $user_row['first']) . ' ' . es($user_row['last_he'] ? $user_row['last_he'] : $user_row['last'])?></H3>
    <?=T_('Rank')?>: <B><?=es($user_row['rank_name'])?></B><BR>
    <?=T_('Serial')?> #: <B><?=$user_row['user_serial']?></B><BR>
    <?=T_('Platoon')?>: <B><?=$user_row['class_grade'], $user_row['class_grade']!=='' && $user_row['class_sub']!=='' ? '-' : '', $user_row['class_sub']?></B><BR>
    <?=T_('Teacher')?>: <B><?=$user_row['class_teacher']?></B><BR>
    <?=T_('Platoon Average')?>: <B><?=is_null($user_row['class_id']) ? T_('N/A') : @number_format(mysql_result(mq(totalMarks("JOIN users USING (user_id) WHERE school_id = {$user['school_id']} AND class_id = {$user_row['class_id']} AND user_start_date IS NOT NULL")), 0) / mysql_result(mq("SELECT COUNT(*) FROM users WHERE school_id = {$user['school_id']} AND class_id = {$user_row['class_id']} AND user_start_date IS NOT NULL"), 0), 2)?></B><BR>
    <?=T_('Total Miles')?>: <B><?=number_format($user_miles = mysql_result(mq(totalMarks("WHERE user_id = {$user['user_id']}")), 0), 2)?></B><BR>
</TD>
</TR>
<? if($user['registered']): ?>
<TR>
<TD id="scan" colspan="2">
<FORM action="statement.php" method="post" accept-charset="UTF-8" autocomplete="off">
<DIV>
<INPUT type="hidden" name="range" value="<?=$range?>">
<?=T_('Scanning Station')?><BR>
<INPUT type="text" name="scan_code" size="25" maxlength="20" id="focus" title="<?=T_('Scan achievement or prize card')?>" autocomplete="off">
</DIV>
<SCRIPT type="text/javascript">document.getElementById('focus').focus();</SCRIPT>
</FORM>

<? else: ?>
<TR>
<TD colspan="2" id="no_scan">
