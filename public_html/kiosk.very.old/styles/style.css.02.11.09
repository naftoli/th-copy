ul li .medals {width:450px; height:300px; float:left;}
ul li .medals div {width:96px; height:100px; float:left; margin:10px 0 0 15px; opacity:.2;}
ul li .medals div a {width:96px; height:100px; display: block;}
ul li .medals div.active {opacity:1;}
ul.ranks li .medals {width:510px;}
ul.ranks li .medals div {margin:0 0 0 5px; opacity:1;}
ul.ranks li .medals .medal {background:url(../images/medals/holder.png); opacity:.4;}

