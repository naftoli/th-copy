@charset "utf-8";
/* CSS Document */

html, body {
	width:100%; height:100%;
}
body {
	background:#000000; text-align:center; font-family:"Myriad Pro", Arial, Helvetica, sans-serif; font-weight:bold; font-size:30px;
}
#wrapper {
	width: 1024px; height:768px; margin:0 auto; background-position:0 0px; text-align: left; text-shadow: 0px -1px 0px #000; position:relative;
	color:#eee;

}
#header {
	height: 140px; background:url(../images/header.jpg); font-size:23px; text-shadow: 1px 1px 4px #000;
}
#main {
	 
}
#main #page_title {
	height:57px; background:url(../images/page_title.png); text-align:center; color:#eee; line-height:40px;
}
#footer {
	width:984px; height:80px; bottom:0; position:absolute; left:0;
}
#print {display:none;}


.yellow #wrapper {
	background-image: url(../images/bg_yellow.jpg);
}
.green #wrapper {
	background-image: url(../images/bg_green.jpg);
}
.lgreen #wrapper {
	background-image: url(../images/bg_lgreen.jpg);
}
.blue #wrapper {
	background-image: url(../images/bg_blue.jpg);
}
.orange #wrapper {
	background-image: url(../images/bg_orange.jpg);
}
.red #wrapper {
	background-image: url(../images/bg_red.jpg);
}

a {
	color:#FFF; text-decoration:none;
}
.alert {
	width:75%; padding:15px; background:#FFCC00; border:1px red solid; color:red; margin:0 auto; text-align:center; z-index:999; position:absolute; top:30px; left:112px; line-height:30px; font-weight:normal;
}
.nav {
	float:right;
}
.nav ul li a {
	width:64px; height:64px;
	display:block;
}
.nav ul li {
	width:64px; height:64px;
	float:left;
	text-indent:-9999px;
	margin:25px 10px;
}
.nav ul li.icon_back {background:url(../images/icon_back.png);}
.nav ul li.icon_home {background:url(../images/icon_home.png);}
.nav ul li.icon_logout {background:url(../images/icon_logout.png);}

.cardpop, .cardpop #wrapper {
	width:770px;
	height:430px;
	background: url(../images/content_cover.png);
	text-align:center;
}
#close_pop a {
	text-indent:-9999px;
	width:60px; height:60px;
	float:right;
	margin-right:23px;
	background:url(../images/button_close.png);
	display:block;
	cursor:pointer;
}


.org {
	padding:15px 30px; line-height:30px;
}
.org img {
	float:left; margin-right:15px;
}


.one_column {
	width:333px; float:left;	
}
.two_column {
	width:683px; float:left;
}
.three_column {
	padding:0 32px;
}
.padding_top {
	padding-top:20px;	
}
.padding_left {
	padding-left:20px;	
}
.clear {
	clear:both;	
}


/*.page_numbers {
	display: inline-table;
	margin-left:20px;
}
.page_numbers li {
	width:35px;
	height:35px;
	float:left;
	font-size:25px;
	line-height:32px;
}
.page_numbers li.active {
	background:url(../images/page_number.png);
}
*/

.buttons {
	text-align:center;
}
.buttons li, .button div {
	width:280px;
	height:80px;
	background:url(../images/buttons_bg.png);
	margin:0 auto;
	margin-bottom:-20px;
	padding:20px;
	font-size:30px;
}
.buttons li:hover, .button div:hover {
	background-position:0 -120px;
}
.buttons li a, .button div a {
	text-decoration:none;
	width:280px;
	height:80px;
	display: table-cell;
	color:#eee;
	vertical-align:middle;
}
.button div.bottom {
	position:absolute;
	bottom:40px;
	right:0;
}
.buttons span.badge {
	width:45px;
	height:45px;
	display:block;
	background:url(../images/badge.png);
	color:#FFF;
	font-size:25px;
	margin:-90px 0 0 250px;
	line-height:40px;
}
.button_icons li a, .button_icons div a {
	width:200px;
	padding-left:80px;
	text-align:left;
}



.checkboxes {
	line-height:35px;
	margin:0 10px;
	text-align:left;
}
.checkboxes div {
	margin:8px;
	border-bottom:1px dotted #fff;
}
.checkboxes input {
	display:none;
}
.checkboxes a {
	width:48px; height:40px;
	display:block;
	background-image:url(../images/icon_checks.png);
	/*border:3px solid #6C3;*/
	float:left;
	margin:0 10px;
}
.checkboxes a:hover, .checkboxes .checked a {
	background-position: bottom;
}

#button_register {
	display:none;
}
#button_register.show {
	display:block;
}




/********---Welcome Page*****/
.member_info_box {
	margin:0 auto;
	padding-left:80px;
}
.member_photo {
	float:left;
}
.member_photo_img {
	width:150px; height:150px;
	margin:19px;
	float:left;
	text-align:center;
}
.member_photo_img img {
	margin:0 auto;
}
.member_photo_cover {
	width:192px;
	height:192px;
	display:block;
	background:url(../images/member_photo_cover.png) no-repeat;
	position:relative;
	padding-right:35px;
}
.member_info {
	font-size:22px;
	width:320px;
	line-height:27px;
	float:left;
}
.member_info li {
}
.member_info li label {
	font-size:13px;
	text-transform: uppercase;
}
.member_info li.member_name {
	
	border-bottom:1px dotted #fff;
}
.member_badge {
	width:100px;
	height:100px;
	position:absolute;
	margin-top:-80px;
	margin-left:120px;
}


.scan_card {
	width:540px;
	height:200px;
	display:block;
	background:url(../images/scan_cover.png);
	position:relative;
	margin:30px auto;
	text-align:center;
}
.scan_card input {
	width:320px;
	height:30px;
	border:2px solid #000;
	margin:10px 0;
	color:#000;
	font-size:25px;
	font-weight:bold;
	padding:2px;
	text-align:center;
}
.scan_card_inside {
	padding-top:70px;	
}



#sb-body {background-color: transparent; border:none;}
#sb-loading, #sb-nav a {display:none;}

.cardpop #page_title {	background:none; margin:60px 0 10px;}

.card_box {
	background:url(../images/card_back.png);
	width:368px; height:217px;
	margin:0 auto;
	text-align:left;
}
.card_box img {
	margin:3px 0 0 5px;
}

ul.button_icons {margin:auto;}


.button_icons li {float:left;}


ul.button_icons li a.icon_profile {background:url(../images/icon_profile.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_deposit {background:url(../images/icon_deposit.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_withdraw {background:url(../images/icon_withdraw.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_campaigns {background:url(../images/icon_campaign.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_wall {background:url(../images/icon_wall.png) no-repeat 17px 18px;}

ul.button_icons li a.icon_ranks {background:url(../images/icon_ranks.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_medals {background:url(../images/icon_medals.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_mileage {background:url(../images/icon_wall.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_missions {background:url(../images/icon_wall.png) no-repeat 17px 18px;}

div.button_icons div a.icon_deposit {background:url(../images/icon_deposit.png) no-repeat 17px 18px;}
div.button_icons div a.icon_withdraw {background:url(../images/icon_print.png) no-repeat 17px 18px;}


ul.button_icons li a.icon_aleph {background:url(../images/iconc_aleph.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_chitas {background:url(../images/iconc_chitas.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_father {background:url(../images/iconc_fatherson.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_footsteps {background:url(../images/iconc_footsteps.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_gemara {background:url(../images/iconc_gemorah.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_hiskashrus {background:url(../images/iconc_hiskashrus.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_hiskashrus {background:url(../images/iconc_test.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_mashpia {background:url(../images/iconc_mashpia.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_mishnayos {background:url(../images/iconc_mishnayos.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_mivtzoim {background:url(../images/iconc_mivtzoim.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_moshiach {background:url(../images/iconc_moshiach.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_niggunim {background:url(../images/iconc_nigunim.png) no-repeat 17px 18px;}
ul.button_icons li a.icon_tanya {background:url(../images/iconc_tanya.png) no-repeat 17px 18px;}
