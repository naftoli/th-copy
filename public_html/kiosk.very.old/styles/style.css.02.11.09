ul.missions .mission_boxes, ul.tasks .task_boxes {width:711px; height:350px;}
#slider ul.missions li, #slider ul.tasks li {margin:20px 0; height:410px;}
.slider_box {margin:0 32px 0 27px; padding:20px 0; text-align:center;}
ul.missions li .medalImage {width:96px; height:100px; margin:-20px 0 0 0px; opacity:1; position:absolute; z-index:999;}

ul.missions .mission_boxes .mission {width:68px; height:68px; opacity:1; background: url(../images/mission_box.png); margin:0 0 0 0; padding:10px; position:relative; float:left; font-size:18px; }
ul.missions .mission_boxes .inactive {opacity:.3; }
ul.missions .mission_boxes .empty {visibility:hidden; }
ul.missions .mission_boxes .mission .number {font-size:18px; margin-top:8px; }
ul.missions .mission_boxes .mission .date {font-size:12px;}
ul.missions .mission_boxes .mission .meter {position: absolute; bottom:5px; background-image:url(../images/mission_meter.png); background-position:100% 0 ; background-repeat:no-repeat; width:50px; height:6px; margin:0 9px 11px; opacity:1;}
ul.missions .mission_boxes .mission .check_on {position: absolute; /*background:url(../images/badge_check.png);*/ top:0; right:5px; width:28px; height:28px; line-height:23px; font-size:15px;}
ul.missions .mission_boxes .mission .check_off {position: absolute; /*background:url(../images/badge_check.png) right;*/ top:0; right:5px; width:28px; height:28px;}
ul.missions .mission_boxes .mission a {position: absolute; top:5px; left:5px; width:78px; height:78px; display:block}
ul.missions .mission_boxes .button_back a {font-size:15px; font-weight:normal; padding:15px 0;}

ul.missions span.badge {
	width:35px;
	height:35px;
	display:block;
	background:url(../images/page_number.png);
	color:#FFF;
	font-size:15px;
	margin:-5px 0 0 65px;
	line-height:30px;
	font-size:.55em;
	
}


ul.tasks .task_group {
	background:url(../images/bg_carbon.png) top repeat-x; font-size:.7em; -moz-border-radius:12px; -webkit-border-radius:12px; margin:0 10px; clear:both;
}
ul.tasks .title {
	margin:10px 0 0;
}
/*ul.tasks .icon {
	background:url(../images/icon_tasks.png); width:48px; height:48px; float:left; margin:20px 10px 0;
}*/
ul.tasks .task {
	font-size:.8em; font-weight:normal; text-align:left; line-height:28px; margin:0 15px; border-bottom:1px dotted #6587a5; margin-bottom:1px; padding-left:8px;
}
.check_on { 
	background:url(../images/check_circles.png); width:28px; height:28px;
}
.check_off {
	background:url(../images/check_circles.png) right; width:28px; height:28px;	
}
ul.tasks .check_on, ul.tasks .check_off {
	float:right; margin-right:5px;
}
ul.tasks .miles {
	width:75px; float:right; text-align:right; margin-right:15px;
}


.slider_title {
	margin-bottom:10px;	
	border-bottom:1px dotted #597791;
}
.medalImage {
	width:200px; height:210px;
	float:left;
	margin:50px 20px 0;
}
.rankImage {
	width:200px; height:162px;
	float:left;
}


.rank_info {
	width:240px;
	float:left;
	margin:50px 0;
}

/********---Deposit Page*****/
.button_dir {
	background-image:url(../images/next_buttons.png);
	width:64px;
	height:64px;
	margin-top:183px;
}
.button_next {
}
.button_prev {
	background-position:-64px 0;	
}
.button_next:hover {
	background-position:0 -128px;	
}
.button_prev:hover {
	background-position:-64px -128px;	
}
.button_next_disabled {
	background-position:0 -64px;
}
.button_prev_disabled {
	background-position:-64px -64px;
}
li.button_dir a {
	width:64px;
	height:64px;
	display:block;
	text-indent:-9999px;
}

/*.three_column li {
	float:left;
}*/
.three_column .content {
	width:770px;
	height:430px;
	background: url(../images/content_cover.png);
	margin:0 auto;
	position:relative;
}
.three_column .content #slider {
}
.three_column .content .card_single {
	margin:0 auto;
	text-align:center;
	font-size:24px;
	height:390px;
	position:relative;
}
.three_column .content .card_single p {
	margin:10px auto;
}
.card_box {
}
.card_shadow {
	width:350px; height:210px;
	background:url(../images/card_shadow.png) bottom no-repeat;
	float:left;
	margin-bottom:10px;
}
.card_front, .card_back {
	background:#fefefe;
	color:#333;
	text-shadow:none;
	font-size:12px;
	font-weight:normal;
	height:150px;
	padding:25px;
}
.card_front table {
	margin:auto;
}
.card_front p {
	margin:10px auto;
}
.card_front td {
	text-align:left;
	padding:0 8px;
}
.card_front_left {
	margin-right:10px;
}
.card_front .border, .card_back .border {
  border: .03in solid black !important;
  -webkit-border-radius: .04in;
  -moz-border-radius: .04in;
  border-radius: .04in;
  padding:10px 0;
}
.card_front .circle, .card_back .circle {
  border: .03in solid black !important;
  -webkit-border-radius: .2in;
  -moz-border-radius: .2in;
  border-radius: .2in;
  line-height: 18px;
  width: 18px;
  margin: auto !important;
  font-weight: bold;
  text-align: center;
}
.card_back td {
  height: auto;
}
.card_back div  {
	position:relative;
}
.card_back div td div {
  height: auto;
  margin: 0px;
  padding: 0px;
}
.card_back .barcode {
	padding:8px 0;
}
.card_back .points {
  position: absolute;
  width: 2.875in; /* 3.375 - 2 * .25 */
  margin: 0px;
  padding: 0px;
  font: 11px bold;
  line-height: .2in;
  bottom: -.13in; /* line-height/2 + border */
  height: auto;
  text-transform: uppercase;
}
.card_back table {
  margin: auto;
}
.card_back .points td div {
  height: auto;
  margin: 0px;
  padding: 0px .1in;
  background-color: #e0f3d2;
}

.card_withdraw {
	height:370px;
	margin:0 20px 0 10px;
}
.card_withdraw .card_front {
	height:310px;
}



#slider .buttons  {
	position:absolute;
	top:230px;
	left:580px;
	height:121px;

/*	float:right;
*/}
#slider .buttons div.icon_deposit {
	width:126px;
	height:121px;
	background-image:url(../images/button_deposit.png);
	padding:0;
	text-indent:-9999px;
}
.card_single .buttons div:hover {
	background-position:right;
}
.card_single .buttons div a {
	height:121px;
}

.card_single .member_info label {
	display:block;
}
.card_single .member_info span {
	font-size:120%;
}
.card_single .member_info div {
	padding-bottom:10px;
	margin-bottom:10px;
	border-bottom:1px dotted #fff;
}





/********---Profile Page*****/

.rank_badges {
	margin:20px 0 0 40px;	
}

.rank_badges ul.rank_top {
	margin-left:14px;
}
.rank_badges ul.rank_top li {
	width:75px; height:75px;
	background-image:url(../images/rankBadges1.png);
	text-indent:-9999px;
	float:left;
}
.rank_badges ul.rank_bot li {
	width:104px; height:92px;
	background-image:url(../images/rankBadges2.png);
	text-indent:-9999px;
	float:left;
}

.rank_badges ul li.rank1 {background-position:0 0;}
.rank_badges ul li.rank2 {background-position:0 -75px;}
.rank_badges ul li.rank3 {background-position:0 -150px;}
.rank_badges ul li.rank4 {background-position:0 -225px;}
.rank_badges ul li.rank5 {background-position:0 -300px;}
.rank_badges ul li.rank6 {background-position:0 -375px;}
.rank_badges ul li.rank7 {background-position:0 -450px;}
.rank_badges ul li.rank8 {background-position:0 -525px;}

.rank_badges ul li.rank9 {background-position:0 0;}
.rank_badges ul li.rank10 {background-position:0 -92px;}
.rank_badges ul li.rank11 {background-position:0 -184px;}
.rank_badges ul li.rank12 {background-position:0 -276px;}
.rank_badges ul li.rank13 {background-position:0 -368px;}
.rank_badges ul li.rank14 {background-position:0 -460px;}



.rank_badges ul li.currentrank1 {background-position:-75px 0;}
.rank_badges ul li.currentrank2 {background-position:-75px -75px;}
.rank_badges ul li.currentrank3 {background-position:-75px -150px;}
.rank_badges ul li.currentrank4 {background-position:-75px -225px;}
.rank_badges ul li.currentrank5 {background-position:-75px -300px;}
.rank_badges ul li.currentrank6 {background-position:-75px -375px;}
.rank_badges ul li.currentrank7 {background-position:-75px -450px;}
.rank_badges ul li.currentrank8 {background-position:-75px -525px;}

.rank_badges ul li.currentrank9 {background-position:-104px 0;}
.rank_badges ul li.currentrank10 {background-position:-104px -92px;}
.rank_badges ul li.currentrank11 {background-position:-104px -184px;}
.rank_badges ul li.currentrank12 {background-position:-104px -276px;}
.rank_badges ul li.currentrank13 {background-position:-104px -368px;}
.rank_badges ul li.currentrank14 {background-position:-104px -460px;}



/********---End Profile Page*****/



/* Easy Slider */

	#slider ul, #slider li{
		margin:0;
		padding:0;
		list-style:none;
		}
	#slider { 
		margin:0 32px 0 27px;
	}
	#slider li{ 
		/* 
			define width and height of list item (slide)
			entire slider area will adjust according to the parameters provided here
		*/ 
		width:710px;
		height:390px;
		overflow:hidden;
		margin:30px 0;
		text-align:center;
		}	
	#prevBtn, #nextBtn{ 
		display:block;
		width:64px;
		height:64px;
		position:absolute;
		left:-290px;
		top:-270px;
		z-index:1000;
		overflow:hidden;
		text-indent:-9999px;
		background-image:url(../images/next_buttons.png);	
		background-position:-64px -64px;	
		}	
	#nextBtn{ 
		left:585px;
		background-position:0 -64px;	
		}														
	#prevBtn a, #nextBtn a{  
		display:block;
		position:relative;
		width:64px;
		height:64px;
		background-image:url(../images/next_buttons.png);
		background-position:-64px -128px;	
		}	
	#nextBtn a{ 
		background-position:0 -128px;	
		}	
	#prevBtn a:hover{  
		background-position:-64px 0px;	
		}	
	#nextBtn a:hover{  
		background-position:0 0px ;	
		}	
	#upBtn, #dnBtn{ 
		display:block;
		width:64px;
		height:64px;
		position:absolute;
		left:0px;
		top:0px;
		z-index:1000;
		overflow:hidden;
		text-indent:-9999px;
		background-image:url(../images/next_buttons.png);	
		background-position:-64px -64px;	
		}	
	#dnBtn{ 
		left:74px;
		background-position:0 -64px;	
		}														
	#upBtn a, #dnBtn a{  
		display:block;
		position:relative;
		width:64px;
		height:64px;
		background-image:url(../images/next_buttons.png);
		background-position:-64px -128px;	
		}	
	#dnBtn a{ 
		background-position:0 -128px;	
		}	
	#upBtn a:hover{  
		background-position:-64px 0px;	
		}	
	#dnBtn a:hover{  
		background-position:0 0px ;	
		}	
	.button_box {
		position:relative;
		width:138px;
		margin:20px auto;
	}
/*////Easy Slider */
.page_dots {
	width:360px; height:16px;
	background-image: url(../images/page_dots_bg.png);
	margin:0 auto;
	text-align:center;
	position:relative;
}
ol#controls {
	margin:0 auto;
	text-align:center;
	display:inline-block;
	margin-top:2px;
}
ol#controls li {
	text-indent:-9999px;
	width:16px; height:11px;
	background-image: url(../images/page_dots.png);
	cursor:pointer;
	float:left;
	margin:0 4px;
}
ol#controls li.current {
	background-position:right;
}







.footer_logo {
	background:url(../images/cth_logo.png);
	width:113px;
	height:70px;
	float:left;
	margin-left:15px;
}
.footer_logout {
		
}
